/// Becoming an IPC clears real moodlet effects and both good and bad sanity modifiers.
/datum/unit_test/ipc_mood_cleanup/Run()
	for(var/previous_sanity in list(SANITY_INSANE, SANITY_GREAT))
		var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
		human.crit_threshold += 7
		var/original_crit_threshold = human.crit_threshold
		var/datum/mood/mood = human.mob_mood
		human.add_mood_event("ipc_cleanup", /datum/mood_event/drunk, 30)
		var/datum/mood_event/drunk/drunk = mood.mood_events["ipc_cleanup"]
		TEST_ASSERT_NOTNULL(drunk.blush_overlay, "The ordinary moodlet did not apply its blush effect.")
		mood.set_sanity(previous_sanity, override = TRUE)
		TEST_ASSERT(human.has_actionspeed_modifier(ACTIONSPEED_ID_SANITY), "The sanity control did not apply its action-speed modifier.")
		if(previous_sanity == SANITY_INSANE)
			TEST_ASSERT(human.has_movespeed_modifier(MOVESPEED_ID_SANITY), "The insane control did not apply its movement penalty.")
			TEST_ASSERT(human.has_status_effect(/datum/status_effect/hallucination/sanity), "The insane control did not receive sanity hallucinations.")
		human.set_species(/datum/species/ipc)
		TEST_ASSERT_EQUAL(human.mob_mood, mood, "Becoming an IPC removed the mood datum required by other systems.")
		TEST_ASSERT(!mood.enabled, "The IPC retained an enabled mood system.")
		TEST_ASSERT_EQUAL(length(mood.mood_events), 0, "The IPC retained its old moodlets.")
		TEST_ASSERT(QDELETED(drunk), "The old moodlet was discarded without being deleted.")
		TEST_ASSERT_NULL(drunk.blush_overlay, "Deleting the old moodlet skipped its effect cleanup.")
		TEST_ASSERT_EQUAL(mood.sanity, SANITY_NEUTRAL, "The IPC retained its previous sanity.")
		TEST_ASSERT_EQUAL(human.crit_threshold, original_crit_threshold, "Clearing insanity changed an unrelated critical-threshold adjustment.")
		TEST_ASSERT(!human.has_movespeed_modifier(MOVESPEED_ID_SANITY), "The IPC retained a mood movement modifier.")
		TEST_ASSERT(!human.has_actionspeed_modifier(ACTIONSPEED_ID_SANITY), "The IPC retained a mood action-speed modifier.")
		TEST_ASSERT(!human.has_status_effect(/datum/status_effect/hallucination/sanity), "The IPC retained sanity hallucinations.")

/// New moods, direct sanity changes, death and revival must not reactivate IPC emotions.
/datum/unit_test/ipc_mood_lifecycle/Run()
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left, /datum/species/ipc)
	var/datum/mood/mood = ipc.mob_mood
	TEST_ASSERT_NOTNULL(mood, "A newly created IPC has no safe mood datum.")
	TEST_ASSERT(!mood.enabled, "A newly created IPC started with mood enabled.")
	TEST_ASSERT(!(mood in SSmood.processing), "A newly created IPC processes mood.")
	ipc.add_mood_event("ipc_positive", /datum/mood_event/hug)
	mood.add_mood_event("ipc_negative", /datum/mood_event/starving)
	var/mob/living/carbon/human/witnessed = allocate(/mob/living/carbon/human/consistent)
	witnessed.death()
	mood.add_conditional_mood_event("ipc_conditional", /datum/mood_event/conditional/see_death, witnessed, FALSE, FALSE)
	mood.direct_sanity_drain(-100)
	mood.set_sanity(SANITY_MAXIMUM, override = TRUE)
	mood.process(1)
	TEST_ASSERT_EQUAL(length(mood.mood_events), 0, "An IPC accumulated normal or conditional moodlets.")
	TEST_ASSERT_EQUAL(mood.sanity, SANITY_NEUTRAL, "A direct sanity change affected an IPC.")
	TEST_ASSERT(!ipc.has_actionspeed_modifier(ACTIONSPEED_ID_SANITY), "A mood update gave the IPC an action-speed effect.")
	ipc.death()
	TEST_ASSERT(ipc.revive(), "The healthy IPC death-and-revival fixture failed.")
	TEST_ASSERT(!mood.enabled, "Revival enabled an IPC's mood system.")
	TEST_ASSERT(!(mood in SSmood.processing), "Revival restarted IPC mood processing.")
	ipc.set_species(/datum/species/ipc)
	TEST_ASSERT(!mood.enabled, "Reapplying the IPC species enabled mood.")
	ipc.set_species(/datum/species/human)
	TEST_ASSERT(mood.enabled, "Returning to a human did not enable mood.")
	TEST_ASSERT(mood in SSmood.processing, "Returning to a living human did not restart mood processing.")
	ipc.add_mood_event("organic_positive", /datum/mood_event/hug)
	mood.add_conditional_mood_event("organic_conditional", /datum/mood_event/conditional/see_death, witnessed, FALSE, FALSE)
	TEST_ASSERT_NOTNULL(mood.mood_events["organic_positive"], "The restored human cannot receive normal moodlets.")
	TEST_ASSERT_NOTNULL(mood.mood_events["organic_conditional"], "The restored human cannot receive conditional moodlets.")
	mood.direct_sanity_drain(-50)
	TEST_ASSERT(mood.sanity < SANITY_NEUTRAL, "The restored human remains immune to sanity changes.")
	ipc.set_species(/datum/species/ipc)
	ipc.death()
	ipc.set_species(/datum/species/human)
	TEST_ASSERT_EQUAL(ipc.stat, DEAD, "The dead transformation fixture unexpectedly revived.")
	TEST_ASSERT(!(mood in SSmood.processing), "Changing a dead IPC into a human started mood processing.")
	TEST_ASSERT(ipc.revive(), "The restored human could not revive.")
	TEST_ASSERT(mood in SSmood.processing, "Reviving the restored human did not restart mood processing.")

/// Both an existing HUD and a HUD created after IPC initialization must omit mood, then restore it for humans.
/datum/unit_test/ipc_mood_hud/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	var/datum/hud/human/human_hud = new(human)
	human.set_hud_used(human_hud)
	SEND_SIGNAL(human, COMSIG_MOB_HUD_CREATED)
	TEST_ASSERT_NOTNULL(human_hud.screen_objects[HUD_MOB_MOOD], "The organic control started without its mood widget.")
	human.set_species(/datum/species/ipc)
	TEST_ASSERT_NULL(human_hud.screen_objects[HUD_MOB_MOOD], "Becoming an IPC retained a mood widget.")
	human.set_species(/datum/species/human)
	TEST_ASSERT_NOTNULL(human_hud.screen_objects[HUD_MOB_MOOD], "Returning to a human did not restore the mood widget.")

	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human, run_loc_floor_bottom_left, /datum/species/ipc)
	var/datum/hud/human/ipc_hud = new(ipc)
	ipc.set_hud_used(ipc_hud)
	SEND_SIGNAL(ipc, COMSIG_MOB_HUD_CREATED)
	TEST_ASSERT_NULL(ipc_hud.screen_objects[HUD_MOB_MOOD], "An IPC's newly created HUD included mood.")
	qdel(ipc_hud)
	var/datum/hud/human/recreated_hud = new(ipc)
	ipc.set_hud_used(recreated_hud)
	SEND_SIGNAL(ipc, COMSIG_MOB_HUD_CREATED)
	TEST_ASSERT_NULL(recreated_hud.screen_objects[HUD_MOB_MOOD], "Recreating the IPC's HUD restored mood.")
	TEST_ASSERT_NOTNULL(recreated_hud.screen_objects[HUD_MOB_HEALTHDOLL], "Removing mood also removed the IPC health doll.")
	ipc.set_species(/datum/species/human)
	TEST_ASSERT_NOTNULL(recreated_hud.screen_objects[HUD_MOB_MOOD], "The recreated HUD did not restore mood for an organic human.")
