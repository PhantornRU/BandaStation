/// Route each outgoing message through one usable headset, including a left-only channel.
/datum/unit_test/dual_ears_radio
	var/list/transmit_counts = list()

/datum/unit_test/dual_ears_radio/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset/headset_med)
	TEST_ASSERT(human.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not equip the right headset.")
	TEST_ASSERT(human.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT), "Could not equip the left headset.")
	RegisterSignal(right, COMSIG_RADIO_NEW_MESSAGE, PROC_REF(on_radio_message))
	RegisterSignal(left, COMSIG_RADIO_NEW_MESSAGE, PROC_REF(on_radio_message))

	human.radio("Common test", list(MODE_HEADSET = TRUE), list(), /datum/language/common)
	TEST_ASSERT_EQUAL(transmit_counts[REF(right)], 1, "Common speech did not prefer the right headset.")
	TEST_ASSERT_NULL(transmit_counts[REF(left)], "Common speech was duplicated through the left headset.")
	human.radio("Medical test", list(RADIO_EXTENSION = RADIO_CHANNEL_MEDICAL), list(), /datum/language/common)
	TEST_ASSERT_EQUAL(transmit_counts[REF(left)], 1, "A channel available only in the left headset was not transmitted.")
	human.radio("Department test", list(RADIO_EXTENSION = MODE_DEPARTMENT), list(), /datum/language/common)
	TEST_ASSERT_EQUAL(transmit_counts[REF(left)], 2, "Department speech did not fall back to the headset with a department channel.")

	right.set_broadcasting(FALSE)
	TEST_ASSERT_EQUAL(human.get_headset_for_channel(), left, "A muted right microphone blocked the left headset.")
	right.set_broadcasting(TRUE)
	right.wires.cut(WIRE_TX)
	TEST_ASSERT_EQUAL(human.get_headset_for_channel(), left, "A cut right transmitter blocked the left headset.")
	right.wires.cut(WIRE_TX)
	right.set_on(FALSE)
	TEST_ASSERT_EQUAL(human.get_headset_for_channel(), left, "A powered-off right headset blocked the left headset.")
	left.channels[RADIO_CHANNEL_MEDICAL] = FALSE
	TEST_ASSERT_NULL(human.get_headset_for_channel(RADIO_CHANNEL_MEDICAL), "A disabled channel was selected for transmission.")

	left.special_channels |= RADIO_SPECIAL_BINARY
	TEST_ASSERT(human.binarycheck(), "A binary translator in the left ear was ignored.")
	TEST_ASSERT(human.temporarilyRemoveItemFromInventory(right), "Could not remove the right headset.")
	TEST_ASSERT_EQUAL(human.get_headset_for_channel(), left, "A headset worn only on the left was ignored.")

/datum/unit_test/dual_ears_radio/proc/on_radio_message(datum/source)
	SIGNAL_HANDLER
	transmit_counts[REF(source)] = (transmit_counts[REF(source)] || 0) + 1
	return COMPONENT_CANNOT_USE_RADIO

/// Dropping or rekeying one headset must preserve translations granted by the other.
/datum/unit_test/dual_ears_languages/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset/headset_med)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset/headset_eng)
	right.keyslot.language_data = list(/datum/language/draconic = 100, /datum/language/moffic = 25)
	left.keyslot.language_data = list(/datum/language/draconic = 100, /datum/language/moffic = 60)
	TEST_ASSERT(human.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not equip the right translator.")
	TEST_ASSERT(human.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT), "Could not equip the left translator.")
	var/datum/language_holder/holder = human.get_language_holder()
	TEST_ASSERT(human.has_language(/datum/language/draconic, UNDERSTOOD_LANGUAGE), "Headsets did not grant full translation.")
	TEST_ASSERT_EQUAL(holder.has_partial_language(/datum/language/moffic), 60, "Two headsets did not retain their best partial translation.")

	TEST_ASSERT(human.temporarilyRemoveItemFromInventory(right), "Could not remove the right translator.")
	TEST_ASSERT(human.has_language(/datum/language/draconic, UNDERSTOOD_LANGUAGE), "Removing one headset cleared the other's full translation.")
	TEST_ASSERT_EQUAL(holder.has_partial_language(/datum/language/moffic), 60, "Removing one headset cleared the other's partial translation.")
	left.keyslot.language_data = list(/datum/language/moffic = 30)
	left.recalculateChannels()
	TEST_ASSERT(!human.has_language(/datum/language/draconic, UNDERSTOOD_LANGUAGE), "Rekeying the left headset kept a removed translation.")
	TEST_ASSERT_EQUAL(holder.has_partial_language(/datum/language/moffic), 30, "Rekeying a worn left headset did not update partial translation.")
	TEST_ASSERT(human.temporarilyRemoveItemFromInventory(left), "Could not remove the left translator.")
	TEST_ASSERT(!holder.has_partial_language(/datum/language/moffic), "Removing the last headset kept its partial translation.")

/// Each mining headset owns its speech boost, and either ear enables its callouts.
/datum/unit_test/dual_ears_mining_traits/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset/headset_cargo/mining)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset/headset_cargo/mining)
	TEST_ASSERT(human.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not equip the right mining headset.")
	TEST_ASSERT(human.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT), "Could not equip the left mining headset.")
	var/datum/component/callouts/callouts = left.GetComponent(/datum/component/callouts)
	TEST_ASSERT_NOTNULL(callouts, "The mining headset has no callouts component.")
	TEST_ASSERT_EQUAL(callouts.cur_user, human, "Mining callouts did not recognize a headset in the left ear.")
	TEST_ASSERT(HAS_TRAIT(human, TRAIT_SPEECH_BOOSTER), "Worn mining headsets did not grant speech boost.")
	TEST_ASSERT(human.temporarilyRemoveItemFromInventory(right), "Could not remove the right mining headset.")
	TEST_ASSERT(HAS_TRAIT(human, TRAIT_SPEECH_BOOSTER), "Removing one mining headset cleared the other's speech boost.")
	TEST_ASSERT(human.temporarilyRemoveItemFromInventory(left), "Could not remove the left mining headset.")
	TEST_ASSERT(!HAS_TRAIT(human, TRAIT_SPEECH_BOOSTER), "Removing the last mining headset kept its speech boost.")
	TEST_ASSERT_NULL(callouts.cur_user, "Removing the left headset kept its callouts attached to the wearer.")

/// Ear protection and newly attached wearer components work in either ear and clean up separately.
/datum/unit_test/dual_ears_protection/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	var/baseline_protection = human.get_ear_protection()
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset/headset_sec/alt)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset/blueshield/alt)
	TEST_ASSERT(human.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not equip the right protected headset.")
	TEST_ASSERT(human.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT), "Could not equip the left protected headset.")
	TEST_ASSERT_EQUAL(human.get_ear_protection(), baseline_protection + 2 * EAR_PROTECTION_NORMAL, "Protected headsets did not both contribute ear protection.")
	var/datum/component/callouts/callouts = left.AddComponent(/datum/component/callouts, ITEM_SLOT_EARS)
	TEST_ASSERT_NOTNULL(callouts, "Could not add a callouts component to the worn left headset.")
	TEST_ASSERT_EQUAL(callouts.cur_user, human, "A component added to a worn left headset did not recognize its slot.")
	TEST_ASSERT(human.temporarilyRemoveItemFromInventory(right), "Could not remove the right protected headset.")
	TEST_ASSERT_EQUAL(human.get_ear_protection(), baseline_protection + EAR_PROTECTION_NORMAL, "Removing one headset removed the other's ear protection.")
	TEST_ASSERT(human.temporarilyRemoveItemFromInventory(left), "Could not remove the left protected headset.")
	TEST_ASSERT_EQUAL(human.get_ear_protection(), baseline_protection, "Removing the last headset kept its ear protection.")

/// Saved outfits preserve both ears and continue accepting the old single-ear JSON format.
/datum/unit_test/dual_ears_outfit/Run()
	var/datum/outfit/outfit = allocate(/datum/outfit)
	outfit.ear_right = /obj/item/radio/headset/headset_med
	outfit.ear_left = /obj/item/radio/headset/headset_eng
	var/list/saved = json_decode(json_encode(outfit.get_json_data()))
	TEST_ASSERT_EQUAL(saved["ear_right"], "[outfit.ear_right]", "Saved outfits lost the right ear.")
	TEST_ASSERT_EQUAL(saved["ear_left"], "[outfit.ear_left]", "Saved outfits lost the left ear.")
	TEST_ASSERT(!("ears" in saved), "Saved outfits still use the obsolete single-ear key.")
	var/datum/outfit/restored = allocate(/datum/outfit)
	TEST_ASSERT(restored.load_from(saved), "Could not load a two-ear outfit.")
	TEST_ASSERT_EQUAL(restored.ear_right, outfit.ear_right, "Loading an outfit changed the right ear.")
	TEST_ASSERT_EQUAL(restored.ear_left, outfit.ear_left, "Loading an outfit changed the left ear.")
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT(restored.equip(human), "Could not equip a restored two-ear outfit.")
	TEST_ASSERT(istype(human.ear_right, /obj/item/radio/headset/headset_med), "The restored right-ear item was not equipped.")
	TEST_ASSERT(istype(human.ear_left, /obj/item/radio/headset/headset_eng), "The restored left-ear item was not equipped.")
	var/datum/outfit/copied = allocate(/datum/outfit)
	copied.copy_from(restored)
	TEST_ASSERT_EQUAL(copied.ear_right, restored.ear_right, "Copying an outfit lost the right ear.")
	TEST_ASSERT_EQUAL(copied.ear_left, restored.ear_left, "Copying an outfit lost the left ear.")
	var/list/preloaded = copied.get_types_to_preload()
	var/list/disguise = copied.get_chameleon_disguise_info()
	TEST_ASSERT((copied.ear_right in preloaded) && (copied.ear_left in preloaded), "Outfit preloading omitted an ear.")
	TEST_ASSERT((copied.ear_right in disguise) && (copied.ear_left in disguise), "Chameleon outfit matching omitted an ear.")
	var/datum/outfit/varedit/edited = allocate(/datum/outfit/varedit)
	edited.set_equipment_by_slot(ITEM_SLOT_EAR_RIGHT, outfit.ear_right)
	edited.set_equipment_by_slot(ITEM_SLOT_EAR_LEFT, outfit.ear_left)
	TEST_ASSERT_EQUAL(edited.ear_right, outfit.ear_right, "VV outfit capture lost the right ear.")
	TEST_ASSERT_EQUAL(edited.ear_left, outfit.ear_left, "VV outfit capture lost the left ear.")

	TEST_ASSERT(restored.load_from(list("ears" = "[outfit.ear_right]")), "Could not load an old single-ear outfit.")
	TEST_ASSERT_EQUAL(restored.ear_right, outfit.ear_right, "The legacy ears key was not loaded into the right ear.")
	TEST_ASSERT_NULL(restored.ear_left, "A legacy outfit unexpectedly populated the left ear.")
	TEST_ASSERT(restored.load_from(list("ear_right" = null, "ears" = "[outfit.ear_right]")), "Could not load an explicitly empty right ear.")
	TEST_ASSERT_NULL(restored.ear_right, "The legacy ears key overrode an explicitly empty right ear.")
