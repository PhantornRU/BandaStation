/// Ear slots must follow the same equip, lookup, coverage and priority paths as other clothing.
/datum/unit_test/dual_ears_inventory/Run()
	var/mob/living/carbon/human/consistent/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/spare = allocate(/obj/item/radio/headset)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "Could not equip the right-ear fixture.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE), "Could not equip the left-ear fixture.")
	TEST_ASSERT_EQUAL(wearer.ear_right, right, "The right ear did not retain its item.")
	TEST_ASSERT_EQUAL(wearer.ear_left, left, "The left ear did not retain its item.")
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), right, "The right slot returned the wrong item.")
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_LEFT), left, "The left slot returned the wrong item.")
	TEST_ASSERT_EQUAL(wearer.get_slot_by_item(right), ITEM_SLOT_EAR_RIGHT, "The right headset returned the wrong slot.")
	TEST_ASSERT_EQUAL(wearer.get_slot_by_item(left), ITEM_SLOT_EAR_LEFT, "The left headset returned the wrong slot.")
	var/list/equipped = wearer.get_equipped_items()
	TEST_ASSERT((right in equipped) && (left in equipped), "Equipped-item enumeration omitted an ear.")
	var/list/selected = wearer.get_items_by_slots(ITEM_SLOT_EARS)
	TEST_ASSERT((right in selected) && (left in selected), "The aggregate ears mask did not select both items.")
	TEST_ASSERT(!wearer.equip_to_slot_if_possible(spare, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "An occupied right ear accepted a second item.")
	TEST_ASSERT(!wearer.equip_to_slot_if_possible(spare, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE), "An occupied left ear accepted a second item.")
	TEST_ASSERT_EQUAL(wearer.ear_right, right, "A rejected equip displaced the right headset.")
	TEST_ASSERT_EQUAL(wearer.ear_left, left, "A rejected equip displaced the left headset.")

	var/obj/item/clothing/head/helmet/cover = allocate(/obj/item/clothing/head/helmet)
	cover.flags_inv |= HIDEEARS
	TEST_ASSERT(wearer.equip_to_slot_if_possible(cover, ITEM_SLOT_HEAD, disable_warning = TRUE), "Could not equip ear-hiding headgear.")
	TEST_ASSERT_EQUAL(hidden_slots_to_inventory_slots(HIDEEARS), ITEM_SLOT_EARS, "HIDEEARS did not conceal both inventory slots.")
	var/list/visible = wearer.get_visible_items()
	TEST_ASSERT(!(right in visible) && !(left in visible), "Ear-hiding headgear left an ear item visible.")
	TEST_ASSERT(wearer.dropItemToGround(cover), "Could not remove the ear-hiding headgear.")
	visible = wearer.get_visible_items()
	TEST_ASSERT((right in visible) && (left in visible), "Removing headgear did not reveal both ear items.")

	var/mob/living/carbon/human/consistent/automatic = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/first = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/second = allocate(/obj/item/radio/headset)
	TEST_ASSERT(automatic.equip_to_appropriate_slot(first), "Automatic equipment could not use the first empty ear.")
	TEST_ASSERT_EQUAL(automatic.ear_right, first, "Automatic equipment did not prefer the right ear.")
	TEST_ASSERT(automatic.equip_to_appropriate_slot(second), "Automatic equipment could not use the remaining ear.")
	TEST_ASSERT_EQUAL(automatic.ear_left, second, "Automatic equipment did not fall back to the left ear.")

	var/mob/living/carbon/human/consistent/headless = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/head/detached_head = headless.get_bodypart(BODY_ZONE_HEAD)
	allocated += detached_head
	detached_head.drop_limb(special = TRUE)
	TEST_ASSERT_NULL(headless.get_bodypart(BODY_ZONE_HEAD), "The headless fixture still has a head.")
	TEST_ASSERT(!headless.equip_to_slot_if_possible(spare, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "A headless mob could equip its right ear.")
	TEST_ASSERT(!headless.equip_to_slot_if_possible(spare, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE), "A headless mob could equip its left ear.")

/// Moving, deleting and decapitating must remove the exact item without retaining a stale ear reference.
/datum/unit_test/dual_ears_lifecycle/Run()
	var/mob/living/carbon/human/consistent/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "Could not equip the right lifecycle fixture.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE), "Could not equip the left lifecycle fixture.")
	TEST_ASSERT(wearer.dropItemToGround(right), "Could not drop the right headset.")
	TEST_ASSERT_NULL(wearer.ear_right, "Dropping the right headset left its slot occupied.")
	TEST_ASSERT_EQUAL(wearer.ear_left, left, "Dropping the right headset cleared the left slot.")
	TEST_ASSERT_EQUAL(right.loc, wearer.drop_location(), "The dropped headset did not reach the ground.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "Could not re-equip the dropped headset.")

	left.forceMove(wearer.drop_location())
	TEST_ASSERT_NULL(wearer.ear_left, "Moving the left headset outside the mob left a stale slot reference.")
	TEST_ASSERT_EQUAL(wearer.ear_right, right, "Moving the left headset cleared the right slot.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE), "Could not re-equip the moved headset.")
	qdel(right)
	TEST_ASSERT_NULL(wearer.ear_right, "Deleting the right headset left a stale slot reference.")
	TEST_ASSERT_EQUAL(wearer.ear_left, left, "Deleting the right headset cleared the left slot.")
	qdel(left)
	TEST_ASSERT_NULL(wearer.ear_left, "Deleting the left headset left a stale slot reference.")
	TEST_ASSERT_NULL(wearer.overlays_standing[EARS_LAYER], "Deleting both headsets left a worn ear overlay.")

	var/obj/item/radio/headset/decap_right = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/decap_left = allocate(/obj/item/radio/headset)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(decap_right, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "Could not equip the right decapitation fixture.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(decap_left, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE), "Could not equip the left decapitation fixture.")
	var/obj/item/bodypart/head/detached_head = wearer.get_bodypart(BODY_ZONE_HEAD)
	allocated += detached_head
	detached_head.drop_limb()
	TEST_ASSERT_NULL(wearer.ear_right, "Losing the head retained the right headset.")
	TEST_ASSERT_NULL(wearer.ear_left, "Losing the head retained the left headset.")
	TEST_ASSERT_EQUAL(decap_right.loc, wearer.drop_location(), "Decapitation did not drop the right headset.")
	TEST_ASSERT_EQUAL(decap_left.loc, wearer.drop_location(), "Decapitation did not drop the left headset.")

	check_fire_coverage()

/// Fire coverage must protect both ears, then expose both when the headgear is removed.
/datum/unit_test/dual_ears_lifecycle/proc/check_fire_coverage()
	var/mob/living/carbon/human/consistent/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/clothing/ears/earmuffs/muffs = allocate(/obj/item/clothing/ears/earmuffs)
	var/obj/item/clothing/head/helmet/cover = allocate(/obj/item/clothing/head/helmet)
	cover.flags_inv |= HIDEEARS
	for(var/primary_ear in list(ITEM_SLOT_EAR_RIGHT, ITEM_SLOT_EAR_LEFT))
		TEST_ASSERT(wearer.equip_to_slot_if_possible(muffs, primary_ear, disable_warning = TRUE), "Could not equip the two-ear fire fixture.")
		TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), muffs, "The fire fixture did not reserve the right ear.")
		TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_LEFT), muffs, "The fire fixture did not reserve the left ear.")
		TEST_ASSERT(wearer.equip_to_slot_if_possible(cover, ITEM_SLOT_HEAD, disable_warning = TRUE), "Could not equip fire-covering headgear.")
		wearer.burn_clothing(1, 4)
		TEST_ASSERT(!(muffs.resistance_flags & ON_FIRE), "Covered two-ear clothing caught fire.")
		TEST_ASSERT(wearer.dropItemToGround(cover), "Could not remove fire-covering headgear.")
		wearer.burn_clothing(1, 4)
		TEST_ASSERT(muffs.resistance_flags & ON_FIRE, "Exposed two-ear clothing was omitted from fire damage.")
		muffs.extinguish()
		TEST_ASSERT(wearer.temporarilyRemoveItemFromInventory(muffs), "Could not remove the two-ear fire fixture.")
