/// Occupancy is symmetric, while the actual equipment slot remains the chosen primary slot.
/datum/unit_test/multi_slot_inventory/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/double = allocate(/obj/item/radio/headset)
	var/datum/component/occupies_slots/slots = double.AddComponent(/datum/component/occupies_slots, ITEM_SLOT_EARS)
	var/obj/item/radio/headset/blocker = allocate(/obj/item/radio/headset)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(blocker, ITEM_SLOT_EAR_RIGHT), "Could not equip the right-ear blocker.")
	TEST_ASSERT(!wearer.equip_to_slot_if_possible(double, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE), "A two-ear item ignored an occupied right ear.")
	TEST_ASSERT(!wearer.can_equip(double, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE, ignore_equipped = TRUE), "ignore_equipped bypassed an occupied required slot.")
	TEST_ASSERT(wearer.dropItemToGround(blocker), "Could not remove the right-ear blocker.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(blocker, ITEM_SLOT_EAR_LEFT), "Could not equip the left-ear blocker.")
	TEST_ASSERT(!wearer.equip_to_slot_if_possible(double, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "A two-ear item ignored an occupied left ear.")
	TEST_ASSERT(wearer.dropItemToGround(blocker), "Could not remove the left-ear blocker.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(double, ITEM_SLOT_EAR_LEFT), "Could not equip the two-ear item with the left ear primary.")
	TEST_ASSERT_EQUAL(slots.wearer, wearer, "The slot component did not retain its wearer.")
	TEST_ASSERT_EQUAL(slots.primary_slot, ITEM_SLOT_EAR_LEFT, "The slot component lost the chosen primary ear.")
	TEST_ASSERT_EQUAL(wearer.ear_left, double, "The real left-ear slot was not assigned.")
	TEST_ASSERT_NULL(wearer.ear_right, "The component duplicated the item into a real secondary slot.")
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), double, "The reserved right ear did not return its item.")
	TEST_ASSERT_EQUAL(wearer.get_slot_by_item(double), ITEM_SLOT_EAR_LEFT, "The reserved slot replaced the actual primary slot.")
	TEST_ASSERT_EQUAL(length(wearer.get_items_by_slots(ITEM_SLOT_EARS)), 1, "Slot enumeration duplicated one physical item.")
	TEST_ASSERT(!wearer.equip_to_slot_if_possible(blocker, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "A single-ear item entered a reserved slot.")
	TEST_ASSERT(!wearer.can_equip(blocker, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE, ignore_equipped = TRUE), "ignore_equipped stole a reserved secondary slot.")
	TEST_ASSERT_EQUAL(double.AddComponent(/datum/component/occupies_slots, ITEM_SLOT_EARS), slots, "Duplicate attachment replaced the slot component.")
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), double, "Duplicate attachment cleared an existing reservation.")

/// All normal removal paths release reservations, including component removal and late attachment.
/datum/unit_test/multi_slot_lifecycle/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/double = allocate(/obj/item/radio/headset)
	var/datum/component/occupies_slots/slots = double.AddComponent(/datum/component/occupies_slots, ITEM_SLOT_EARS)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(double, ITEM_SLOT_EAR_RIGHT), "Could not equip the lifecycle fixture.")
	TEST_ASSERT(wearer.dropItemToGround(double), "Could not drop the two-ear item.")
	TEST_ASSERT_NULL(wearer.get_item_by_slot(ITEM_SLOT_EAR_LEFT), "Dropping the item left a reservation.")
	TEST_ASSERT_NULL(slots.wearer, "Dropping the item retained the wearer.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(double, ITEM_SLOT_EAR_LEFT), "Could not re-equip the lifecycle fixture.")
	double.forceMove(wearer.drop_location())
	TEST_ASSERT_NULL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), "forceMove left a secondary reservation.")
	TEST_ASSERT_NULL(wearer.get_item_by_slot(ITEM_SLOT_EAR_LEFT), "forceMove left the primary slot occupied.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(double, ITEM_SLOT_EAR_LEFT), "Could not equip the component-removal fixture.")
	qdel(slots)
	TEST_ASSERT_NULL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), "Deleting the component left its reservation.")
	TEST_ASSERT_EQUAL(wearer.ear_left, double, "Deleting the component removed its item from the primary slot.")
	slots = double.AddComponent(/datum/component/occupies_slots, ITEM_SLOT_EARS)
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), double, "Attaching a component to a worn item did not reserve its other slot.")
	qdel(double)
	TEST_ASSERT_NULL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), "Deleting the item left a secondary reservation.")
	TEST_ASSERT_NULL(wearer.get_item_by_slot(ITEM_SLOT_EAR_LEFT), "Deleting the item left the primary slot occupied.")
	TEST_ASSERT_NULL(wearer.occupied_clothing_slots, "Removing the last item retained the reservation map.")

	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT), "Could not equip the late-attachment blocker.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not equip the late-attachment fixture.")
	right.AddComponent(/datum/component/occupies_slots, ITEM_SLOT_EARS)
	TEST_ASSERT_NULL(wearer.ear_right, "Late attachment kept clothing whose other required slot was occupied.")
	TEST_ASSERT_EQUAL(wearer.ear_left, left, "Late attachment displaced the other item.")
	TEST_ASSERT_EQUAL(right.loc, wearer.drop_location(), "Late attachment did not safely return the incompatible item to the ground.")
	wearer.equip_to_slot(right, ITEM_SLOT_EAR_RIGHT)
	TEST_ASSERT_NULL(wearer.ear_right, "An unsafe equip call kept clothing over an occupied required slot.")
	TEST_ASSERT_EQUAL(wearer.ear_left, left, "An unsafe equip call displaced the other item.")
	TEST_ASSERT_NULL(wearer.occupied_clothing_slots, "A rejected unsafe equip left reservations.")

	var/mob/living/carbon/human/deleting = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT(deleting.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not equip the wearer-deletion fixture.")
	slots = right.GetComponent(/datum/component/occupies_slots)
	qdel(deleting)
	TEST_ASSERT_NULL(slots.wearer, "Deleting the wearer retained a component reference to it.")

/// The component must work for clothing slots other than ears as well.
/datum/unit_test/multi_slot_generic/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/clothing/head/helmet/combined = allocate(/obj/item/clothing/head/helmet)
	combined.slot_flags |= ITEM_SLOT_MASK
	combined.AddComponent(/datum/component/occupies_slots, ITEM_SLOT_HEAD | ITEM_SLOT_MASK)
	var/obj/item/clothing/mask/surgical/blocker = allocate(/obj/item/clothing/mask/surgical)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(blocker, ITEM_SLOT_MASK), "Could not equip the generic mask blocker.")
	TEST_ASSERT(!wearer.equip_to_slot_if_possible(combined, ITEM_SLOT_HEAD, disable_warning = TRUE), "A head/mask item ignored an occupied mask slot.")
	TEST_ASSERT(wearer.dropItemToGround(blocker), "Could not remove the mask blocker.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(combined, ITEM_SLOT_HEAD), "Could not equip generic two-slot clothing.")
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_MASK), combined, "The generic secondary slot was not reserved.")
	TEST_ASSERT_EQUAL(wearer.get_slot_by_item(combined), ITEM_SLOT_HEAD, "Generic clothing lost its primary slot.")
	TEST_ASSERT(wearer.dropItemToGround(combined), "Could not remove generic two-slot clothing.")
	TEST_ASSERT_NULL(wearer.get_item_by_slot(ITEM_SLOT_MASK), "Removing generic clothing left the mask reserved.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(combined, ITEM_SLOT_MASK), "Could not choose the mask as the primary slot.")
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_HEAD), combined, "The reversed generic secondary slot was not reserved.")
	TEST_ASSERT_EQUAL(wearer.get_slot_by_item(combined), ITEM_SLOT_MASK, "Reversed generic clothing lost its primary slot.")
