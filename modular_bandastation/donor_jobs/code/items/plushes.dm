/obj/item/toy/plush/donor/greyplushie
	var/next_hug = 0
	var/next_scream = 0
	var/singed = FALSE

/obj/item/toy/plush/donor/greyplushie/Initialize(mapload)
	. = ..()
	RegisterSignal(src, COMSIG_ATOM_EXPOSE_REAGENTS, PROC_REF(water_exposure))
	AddElement(/datum/element/update_icon_updates_onmob)

/obj/item/toy/plush/donor/greyplushie/proc/water_exposure(atom/source, list/reagents, datum/reagents/holder, methods)
	SIGNAL_HANDLER
	var/datum/reagent/water/water = locate() in reagents
	if(!water || world.time < next_scream)
		return
	next_scream = world.time + 30 SECONDS
	playsound(src, 'modular_bandastation/donor_jobs/sound/grey_scream.ogg', 10, FALSE)
	visible_message(span_danger("AAAAAAH!"))
	if(singed)
		return
	singed = TRUE
	icon_state = "grey_singed"
	inhand_icon_state = "grey_singed"
	desc = "A ruined plushie of a grey. It looks like someone ran it under some water."
	normal_desc = desc
	update_appearance(UPDATE_ICON)

/obj/item/toy/plush/donor/greyplushie/attack_self(mob/user)
	. = ..()
	if(world.time < next_hug)
		return
	next_hug = world.time + 5 SECONDS
	visible_message(span_danger(singed ? "Ow..." : "☝︎❒︎♏︎♏︎⧫︎♓︎■︎♑︎⬧︎📬︎"))

/obj/item/toy/plush/donor/voxplushie
	var/next_skree = 0

/obj/item/toy/plush/donor/voxplushie/attack_self(mob/user)
	if(world.time < next_skree)
		return ..()
	next_skree = world.time + 3 SECONDS
	playsound(src, 'modular_bandastation/donor_jobs/sound/vox_shriek.ogg', 10, FALSE)
	visible_message(span_danger("Skreee!"))

/obj/item/toy/plush/donor/nianplushie
