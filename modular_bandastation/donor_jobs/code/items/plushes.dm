/obj/item/toy/plush/donor/fluff/fox
	name = "orange fox plushie"
	desc = "A cute, soft, fuzzy, fluffy, and cuddly plushie. This has a small tag on it that is signed 'Fox McCloud'."
	icon_state = "orangefox"
	actions_types = list(/datum/action/item_action/donor_plush_color)
	var/prompting_change = FALSE
	var/static/list/plush_colors = list("red fox plushie" = "redfox", "black fox plushie" = "blackfox", "marble fox plushie" = "marblefox", "blue fox plushie" = "bluefox", "orange fox plushie" = "orangefox", "coffee fox plushie" = "coffeefox", "pink fox plushie" = "pinkfox", "purple fox plushie" = "purplefox", "crimson fox plushie" = "crimsonfox")

/datum/action/item_action/donor_plush_color
	name = "Change plushie color"

/obj/item/toy/plush/donor/fluff/fox/ui_action_click(mob/user, datum/action/action)
	if(prompting_change)
		return
	prompting_change = TRUE
	var/selected = tgui_input_list(user, "Select a color", name, plush_colors)
	prompting_change = FALSE
	if(QDELETED(src) || !(selected in plush_colors) || !Adjacent(user))
		return
	name = selected
	icon_state = plush_colors[selected]
	update_appearance(UPDATE_ICON)
	for(var/datum/action/button as anything in actions)
		button.build_all_button_icons(UPDATE_BUTTON_OVERLAY)

