	visible_message(span_danger("Buzzzz!"))

/obj/item/toy/plush/donor/ipcplushie/item_interaction(mob/living/user, obj/item/tool, list/modifiers)
	if(!istype(tool, /obj/item/food/breadslice))
		return ..()
	if(!user.transferItemToLoc(tool, src))
		return ITEM_INTERACT_BLOCKING
	qdel(tool)
	new /obj/item/food/donor_toast(user.drop_location())
	playsound(src, 'sound/machines/ding.ogg', 50, TRUE)
	to_chat(user, span_notice("You insert bread into the toaster."))
	return ITEM_INTERACT_SUCCESS
