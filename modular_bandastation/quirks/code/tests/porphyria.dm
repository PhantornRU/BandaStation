/// Blood hunger takes forty minutes to empty, then allows three minutes to obtain blood.
/datum/unit_test/porphyria_hunger/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/datum/quirk/porphyria/quirk = allocate(/datum/quirk/porphyria)
	quirk.add_to_holder(holder)
	TEST_ASSERT_EQUAL(quirk.value, -6, "Porphyria has the wrong character creation cost.")
	TEST_ASSERT(!quirk.is_species_appropriate(/datum/species/ipc), "IPCs can select Porphyria.")
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED, forced = TRUE)
	quirk.process(2399)
	TEST_ASSERT(holder.nutrition > 0, "Blood hunger emptied before forty minutes.")
	quirk.process(1)
	TEST_ASSERT(abs(holder.nutrition) < 0.001, "Blood hunger did not empty after forty minutes.")
	TEST_ASSERT(holder.stat != DEAD, "The holder died without their three-minute grace period.")
	quirk.process(179)
	TEST_ASSERT(holder.stat != DEAD, "The holder died before three minutes at zero satiety.")
	quirk.process(1)
	TEST_ASSERT_EQUAL(holder.stat, DEAD, "Three minutes without blood did not kill the holder.")
	TEST_ASSERT(quirk.died_from_starvation, "Blood starvation did not mark the cause needed for revival.")

/// Ordinary ingested blood has half value and excess disappears without affecting other reagents.
/datum/unit_test/porphyria_digestion/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/datum/quirk/porphyria/quirk = allocate(/datum/quirk/porphyria)
	quirk.add_to_holder(holder)
	var/obj/item/organ/stomach/stomach = holder.get_organ_slot(ORGAN_SLOT_STOMACH)
	holder.set_nutrition(0, forced = TRUE)
	stomach.reagents.add_reagent(/datum/reagent/blood, 120)
	stomach.on_life(1)
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED * 0.5, "A blood bag's blood did not restore half a full stomach from 120 units.")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount(/datum/reagent/blood), 0, "Ingested blood survived rapid stomach metabolism.")
	TEST_ASSERT_NULL(holder.mob_mood.mood_events["porphyria_fresh_blood"], "Stored blood granted the fresh-blood mood bonus.")
	holder.adjust_nutrition(100)
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED * 0.5, "Ordinary food nutrition bypassed blood feeding.")
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED)
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED * 0.5, "An ordinary nutrition setter bypassed blood feeding.")
	stomach.handle_hunger(holder, 10)
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED * 0.5, "Normal stomach hunger accelerated the forty-minute blood hunger timer.")
	stomach.reagents.add_reagent(/datum/reagent/blood, 400)
	stomach.reagents.add_reagent(/datum/reagent/water, 20)
	quirk.metabolize_blood()
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED, "Excess blood increased nutrition beyond its maximum.")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount(/datum/reagent/blood), 0, "Excess blood remained in a living holder's stomach.")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount(/datum/reagent/water), 20, "Blood metabolism consumed another reagent.")

/// Revival needs fifty units, leaves surplus, and does not bypass unrelated causes of death.
/datum/unit_test/porphyria_revival/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/datum/quirk/porphyria/quirk = allocate(/datum/quirk/porphyria)
	quirk.add_to_holder(holder)
	var/obj/item/organ/stomach/stomach = holder.get_organ_slot(ORGAN_SLOT_STOMACH)
	holder.set_nutrition(0, forced = TRUE)
	quirk.process(180)
	TEST_ASSERT_EQUAL(holder.stat, DEAD, "The revival fixture did not die of blood starvation.")
	stomach.reagents.add_reagent(/datum/reagent/blood, 49)
	quirk.process(1)
	TEST_ASSERT_EQUAL(holder.stat, DEAD, "Forty-nine units incorrectly revived the holder.")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount(/datum/reagent/blood), 49, "An insufficient revival dose was consumed.")
	stomach.reagents.add_reagent(/datum/reagent/blood, 1)
	quirk.process(1)
	TEST_ASSERT(holder.stat != DEAD, "Fifty units failed to revive an intact starvation victim.")
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED * 0.05, "Revival did not start at five percent nutrition.")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount(/datum/reagent/blood), 0, "The fifty-unit revival dose remained in the stomach.")

	holder.set_nutrition(0, forced = TRUE)
	quirk.process(180)
	stomach.reagents.add_reagent(/datum/reagent/blood, 75)
	quirk.process(1)
	TEST_ASSERT(holder.stat != DEAD, "A dose with surplus failed to revive the holder.")
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED * 0.05, "Revival immediately digested surplus instead of starting at five percent.")
	TEST_ASSERT_EQUAL(stomach.reagents.get_reagent_amount(/datum/reagent/blood), 25, "Revival did not leave exactly the excess blood.")

	var/mob/living/carbon/human/other_holder = allocate(/mob/living/carbon/human/consistent)
	var/datum/quirk/porphyria/other_quirk = allocate(/datum/quirk/porphyria)
	other_quirk.add_to_holder(other_holder)
	var/obj/item/organ/stomach/other_stomach = other_holder.get_organ_slot(ORGAN_SLOT_STOMACH)
	other_holder.death()
	other_stomach.reagents.add_reagent(/datum/reagent/blood, 50)
	other_quirk.process(1)
	TEST_ASSERT_EQUAL(other_holder.stat, DEAD, "Porphyria revived an unrelated death.")
	TEST_ASSERT_EQUAL(other_stomach.reagents.get_reagent_amount(/datum/reagent/blood), 50, "An unrelated corpse lost its blood dose.")

/// Bites remove real blood at fifteen units per second and stop exactly at full satiety.
/datum/unit_test/porphyria_biting/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent, get_step(run_loc_floor_bottom_left, EAST))
	var/datum/quirk/porphyria/quirk = allocate(/datum/quirk/porphyria)
	quirk.add_to_holder(holder)
	holder.set_combat_mode(TRUE)
	holder.zone_selected = BODY_ZONE_HEAD
	holder.start_pulling(victim)
	holder.setGrabState(GRAB_AGGRESSIVE)
	holder.set_nutrition(0, forced = TRUE)
	var/blood_before = victim.get_blood_volume()
	quirk.bite_tick(victim)
	TEST_ASSERT_EQUAL(blood_before - victim.get_blood_volume(), 15, "A one-second bite removed the wrong amount of blood.")
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED * 0.125, "Fifteen units of direct human blood did not restore one eighth of a full stomach.")
	var/datum/mood_event/fresh_blood = holder.mob_mood.mood_events["porphyria_fresh_blood"]
	TEST_ASSERT_NOTNULL(fresh_blood, "A successful human bite did not grant its mood bonus.")
	TEST_ASSERT_EQUAL(fresh_blood.mood_change, 2, "The fresh-blood mood bonus has the wrong strength.")
	TEST_ASSERT_EQUAL(fresh_blood.timeout, 5 MINUTES, "The fresh-blood mood bonus has the wrong duration.")
	TEST_ASSERT_EQUAL(fresh_blood.description, "Как же приятна свежая кровь!", "The fresh-blood mood bonus has the wrong description.")
	var/datum/mood_event/bitten = victim.mob_mood.mood_events["porphyria_bitten"]
	TEST_ASSERT_NOTNULL(bitten, "The bitten victim received no mood penalty.")
	TEST_ASSERT_EQUAL(bitten.timeout, 10 MINUTES, "The bite victim's mood penalty has the wrong duration.")
	TEST_ASSERT_EQUAL(bitten.description, "Меня только что укусили и высосали кровь!", "The bite victim's mood penalty has the wrong description.")
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED * (115 / 120), forced = TRUE)
	blood_before = victim.get_blood_volume()
	quirk.bite_tick(victim)
	TEST_ASSERT_EQUAL(blood_before - victim.get_blood_volume(), 5, "The final bite drained more blood than needed.")
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED, "The final partial bite failed to fill nutrition exactly.")
	TEST_ASSERT(!quirk.can_bite(victim), "A fully satiated holder can keep draining a victim.")

	holder.stop_pulling()
	var/mob/living/carbon/human/species/monkey/monkey = allocate(/mob/living/carbon/human/species/monkey, get_step(run_loc_floor_bottom_left, EAST))
	holder.start_pulling(monkey)
	holder.setGrabState(GRAB_AGGRESSIVE)
	holder.clear_mood_event("porphyria_fresh_blood")
	holder.set_nutrition(0, forced = TRUE)
	blood_before = monkey.get_blood_volume()
	quirk.bite_tick(monkey)
	TEST_ASSERT_EQUAL(blood_before - monkey.get_blood_volume(), 15, "A monkey bite did not drain fifteen units per second.")
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED * 0.0625, "Monkey blood was not half as nourishing.")
	TEST_ASSERT_NULL(holder.mob_mood.mood_events["porphyria_fresh_blood"], "Monkey blood granted the fresh-blood mood bonus.")

/// The bite rechecks capture, target zone, range and life before every blood transfer.
/datum/unit_test/porphyria_bite_validation/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent, get_step(run_loc_floor_bottom_left, EAST))
	var/datum/quirk/porphyria/quirk = allocate(/datum/quirk/porphyria)
	quirk.add_to_holder(holder)
	holder.set_nutrition(0, forced = TRUE)
	holder.set_combat_mode(TRUE)
	holder.zone_selected = BODY_ZONE_HEAD
	holder.start_pulling(victim)
	TEST_ASSERT(!quirk.can_bite(victim), "A passive grab allowed blood drinking.")
	holder.setGrabState(GRAB_AGGRESSIVE)
	TEST_ASSERT(quirk.can_bite(victim), "A valid aggressive head grab could not begin a bite.")
	holder.zone_selected = BODY_ZONE_CHEST
	TEST_ASSERT(!quirk.can_bite(victim), "Changing aim away from the head did not stop blood drinking.")
	holder.zone_selected = BODY_ZONE_HEAD
	holder.stop_pulling()
	var/blood_before = victim.get_blood_volume()
	quirk.bite_tick(victim)
	TEST_ASSERT_EQUAL(victim.get_blood_volume(), blood_before, "An interrupted grab still drained blood.")
	holder.start_pulling(victim)
	holder.setGrabState(GRAB_AGGRESSIVE)
	victim.death()
	TEST_ASSERT(!quirk.can_bite(victim), "A dead victim could be used for a live bite.")
	quirk.bite_tick(victim)
	TEST_ASSERT_EQUAL(victim.get_blood_volume(), blood_before, "A dead victim lost blood to Porphyria.")

/// Hunger effects preserve natural eye colors and completely disappear during vampire conversion.
/datum/unit_test/porphyria_effects/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	var/datum/quirk/porphyria/quirk = allocate(/datum/quirk/porphyria)
	quirk.add_to_holder(holder)
	holder.set_eye_color(COLOR_BLUE, COLOR_GREEN)
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED * 0.75, forced = TRUE)
	quirk.update_effects()
	var/datum/mood_event/hunger = holder.mob_mood.mood_events["porphyria_hunger"]
	TEST_ASSERT_NOTNULL(hunger, "The blood hunger penalty did not begin at seventy-five percent.")
	TEST_ASSERT_EQUAL(hunger.mood_change, -1, "The initial blood hunger penalty is not mild.")
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED * 0.33, forced = TRUE)
	quirk.update_effects()
	TEST_ASSERT_EQUAL(holder.get_left_eye_color(), BLOODCULT_EYE, "The left eye did not become red at thirty-three percent.")
	TEST_ASSERT_EQUAL(holder.get_right_eye_color(), BLOODCULT_EYE, "The right eye did not become red at thirty-three percent.")
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED / 3, forced = TRUE)
	quirk.update_effects()
	TEST_ASSERT_EQUAL(holder.get_left_eye_color(), COLOR_BLUE, "Recovery failed to restore the original left eye color.")
	TEST_ASSERT_EQUAL(holder.get_right_eye_color(), COLOR_GREEN, "Recovery failed to restore the original right eye color.")
	holder.set_nutrition(0, forced = TRUE)
	quirk.update_effects()
	hunger = holder.mob_mood.mood_events["porphyria_hunger"]
	TEST_ASSERT_EQUAL(hunger.mood_change, -6, "The hunger penalty did not grow as blood satiety fell.")
	ADD_TRAIT(holder, TRAIT_VAMPIRE, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT(!quirk.is_active(), "Vampire conversion did not disable Porphyria.")
	TEST_ASSERT_NULL(holder.mob_mood.mood_events["porphyria_hunger"], "A vampire retained the blood hunger mood penalty.")
	TEST_ASSERT_EQUAL(holder.get_left_eye_color(), COLOR_BLUE, "A vampire retained Porphyria's eye color override.")
	quirk.process(3600)
	TEST_ASSERT(holder.stat != DEAD, "Disabled Porphyria killed a vampire.")
	REMOVE_TRAIT(holder, TRAIT_VAMPIRE, TRAIT_SOURCE_UNIT_TESTS)
	quirk.remove_from_current_holder()
	TEST_ASSERT_EQUAL(holder.get_left_eye_color(), COLOR_BLUE, "Removing Porphyria did not restore the left eye color.")
	TEST_ASSERT_EQUAL(holder.get_right_eye_color(), COLOR_GREEN, "Removing Porphyria did not restore the right eye color.")
	TEST_ASSERT_NULL(holder.mob_mood.mood_events["porphyria_hunger"], "Removing Porphyria left its hunger penalty behind.")
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED)
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED, "Removing Porphyria did not restore ordinary food nutrition.")

/// The actual unarmed signal starts one interruptible action and stops it when satiated.
/datum/unit_test/porphyria_bite_action/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent/slow, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent, get_step(run_loc_floor_bottom_left, EAST))
	// Prevent ordinary regeneration from obscuring the exact small drain during the wait.
	victim.set_blood_volume(BLOOD_VOLUME_NORMAL + 15)
	var/datum/quirk/porphyria/quirk = allocate(/datum/quirk/porphyria)
	quirk.add_to_holder(holder)
	// Keep the reserve fixed while this test waits for the real interruptible bite.
	STOP_PROCESSING(SSquirks, quirk)
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED * (115 / 120), forced = TRUE)
	holder.set_combat_mode(TRUE)
	holder.zone_selected = BODY_ZONE_HEAD
	holder.start_pulling(victim)
	holder.setGrabState(GRAB_AGGRESSIVE)
	var/blood_before = victim.get_blood_volume()
	var/nutrition_before = holder.nutrition
	var/attack_result = SEND_SIGNAL(holder, COMSIG_LIVING_EARLY_UNARMED_ATTACK, victim, TRUE, list())
	TEST_ASSERT(attack_result & COMPONENT_CANCEL_ATTACK_CHAIN, "The bite signal did not consume the unarmed attack.")
	TEST_ASSERT(quirk.drinking, "The unarmed attack did not start the asynchronous bite.")
	holder.stop_pulling()
	var/deadline = world.time + 3 SECONDS
	while(quirk.drinking && world.time < deadline)
		sleep(world.tick_lag)
	TEST_ASSERT(!quirk.drinking, "Releasing the grab did not end the asynchronous bite.")
	TEST_ASSERT_EQUAL(victim.get_blood_volume(), blood_before, "The canceled bite still removed blood.")
	TEST_ASSERT_EQUAL(holder.nutrition, nutrition_before, "The canceled bite restored nutrition.")
	TEST_ASSERT_NULL(holder.mob_mood.mood_events["porphyria_fresh_blood"], "The canceled bite granted its mood bonus.")
	TEST_ASSERT_NULL(victim.mob_mood.mood_events["porphyria_bitten"], "The canceled bite granted a victim mood penalty.")

	holder.start_pulling(victim)
	holder.setGrabState(GRAB_AGGRESSIVE)
	attack_result = SEND_SIGNAL(holder, COMSIG_LIVING_EARLY_UNARMED_ATTACK, victim, TRUE, list())
	TEST_ASSERT(attack_result & COMPONENT_CANCEL_ATTACK_CHAIN, "A new valid grab could not restart the bite action.")
	TEST_ASSERT(quirk.drinking, "The repeated unarmed attack did not start its bite.")
	deadline = world.time + 3 SECONDS
	while(quirk.drinking && world.time < deadline)
		sleep(world.tick_lag)
	TEST_ASSERT(!quirk.drinking, "The asynchronous bite did not stop automatically at full nutrition.")
	TEST_ASSERT_EQUAL(blood_before - victim.get_blood_volume(), 5, "The asynchronous bite did not drain exactly the remaining five units.")
	TEST_ASSERT_EQUAL(holder.nutrition, NUTRITION_LEVEL_WELL_FED, "The completed bite did not fill ordinary nutrition.")

/// Adding the quirk to an existing vampire neither feeds them nor applies dormant effects.
/datum/unit_test/porphyria_existing_vampire/Run()
	var/mob/living/carbon/human/holder = allocate(/mob/living/carbon/human/consistent)
	holder.set_eye_color(COLOR_BLUE, COLOR_GREEN)
	ADD_TRAIT(holder, TRAIT_VAMPIRE, TRAIT_SOURCE_UNIT_TESTS)
	holder.set_nutrition(NUTRITION_LEVEL_WELL_FED * 0.2, forced = TRUE)
	var/nutrition_before = holder.nutrition
	var/datum/quirk/porphyria/quirk = allocate(/datum/quirk/porphyria)
	quirk.add_to_holder(holder)
	TEST_ASSERT(!quirk.is_active(), "Porphyria became active when added to an existing vampire.")
	TEST_ASSERT(!quirk.should_process(), "Dormant Porphyria started processing an existing vampire.")
	TEST_ASSERT_EQUAL(holder.nutrition, nutrition_before, "Adding dormant Porphyria fed an existing vampire.")
	TEST_ASSERT_NULL(holder.mob_mood.mood_events["porphyria_hunger"], "An existing vampire received Porphyria's hunger penalty.")
	TEST_ASSERT_EQUAL(holder.get_left_eye_color(), COLOR_BLUE, "Dormant Porphyria changed an existing vampire's left eye color.")
	TEST_ASSERT_EQUAL(holder.get_right_eye_color(), COLOR_GREEN, "Dormant Porphyria changed an existing vampire's right eye color.")
	quirk.process(3600)
	TEST_ASSERT_EQUAL(holder.nutrition, nutrition_before, "Dormant Porphyria drained an existing vampire's nutrition.")
	TEST_ASSERT(holder.stat != DEAD, "Dormant Porphyria killed an existing vampire.")
