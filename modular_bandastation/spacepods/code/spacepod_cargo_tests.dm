/// A real inventory click must retrieve loot without exposing the pod's machinery.
/datum/unit_test/spacepod_cargo_external_loot/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/spacepod_equipment/sec_cargo/loot_box/cargo = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The small cargo bay could not be installed.")
	var/obj/item/flashlight/loot = allocate(__IMPLIED_TYPE__, user.loc)
	TEST_ASSERT(user.put_in_active_hand(loot), "The technician could not hold the test flashlight.")
	loot.melee_attack_chain(user, pod, list())
	TEST_ASSERT_EQUAL(loot.loc, cargo, "The normal item attack chain did not load the installed cargo bay.")
	TEST_ASSERT(loot.IsReachableBy(user), "A nearby technician cannot reach the contents of an unlocked cargo bay.")
	TEST_ASSERT(!pod.battery.IsReachableBy(user), "Opening the cargo bay also exposed the installed battery.")
	TEST_ASSERT(!pod.internal_tank.IsReachableBy(user), "Opening the cargo bay also exposed the reserve tank.")
	click_wrapper(user, cargo)
	TEST_ASSERT_EQUAL(cargo.loc, pod, "A cargo access click removed the installed module through the closed hatch.")
	TEST_ASSERT_EQUAL(pod.sec_cargo_system, cargo, "A cargo access click detached the installed module.")
	click_wrapper(user, loot)
	TEST_ASSERT(user.is_holding(loot), "A real inventory click did not put the original cargo item into the technician's hand.")
	TEST_ASSERT_EQUAL(loot.loc, user, "The retrieved item is still inside the cargo bay.")
	TEST_ASSERT(!(loot.item_flags & IN_STORAGE), "The retrieved item retained its storage flag.")

/// Cargo permissions must also govern clicks made through an already-open inventory.
/datum/unit_test/spacepod_cargo_loot_permissions/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/turf/service_turf = get_step(origin, SOUTH)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, service_turf)
	var/obj/item/spacepod_equipment/sec_cargo/loot_box/cargo = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The test cargo bay could not be installed.")
	var/obj/item/flashlight/loot = allocate(__IMPLIED_TYPE__, user.loc)
	TEST_ASSERT(user.put_in_active_hand(loot), "The technician could not hold the test cargo.")
	loot.melee_attack_chain(user, pod, list())
	TEST_ASSERT_EQUAL(loot.loc, cargo, "The test cargo was not inserted through the normal item attack chain.")
	for(var/condition in list("locked", "open_hatch", "far", "combat", "blocked_hands"))
		switch(condition)
			if("locked")
				pod.unlocked = FALSE
			if("open_hatch")
				pod.hatch_open = TRUE
			if("far")
				user.forceMove(locate(origin.x + 4, origin.y + 4, origin.z))
			if("combat")
				user.set_combat_mode(TRUE)
			if("blocked_hands")
				ADD_TRAIT(user, TRAIT_HANDS_BLOCKED, TRAIT_SOURCE_UNIT_TESTS)
		TEST_ASSERT(!loot.IsReachableBy(user), "[condition] still allowed native reach into the cargo bay.")
		click_wrapper(user, loot)
		TEST_ASSERT_EQUAL(loot.loc, cargo, "[condition] allowed a stale cargo-inventory click to take the item.")
		pod.unlocked = TRUE
		pod.hatch_open = FALSE
		user.forceMove(service_turf)
		user.set_combat_mode(FALSE)
		REMOVE_TRAIT(user, TRAIT_HANDS_BLOCKED, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT(loot.IsReachableBy(user), "Restoring access did not make the cargo item reachable again.")
	TEST_ASSERT(pod.remove_equipment(null, cargo, cargo.slot), "The test cargo module could not be removed.")
	TEST_ASSERT(!pod.IsContainedAtomAccessible(cargo, user), "A detached cargo module is still treated as installed storage.")

/// A dragged crate must be recoverable from both the pilot controls and outside the pod.
/datum/unit_test/spacepod_cargo_crate_roundtrip/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	pod.enter_delay = 0
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	user.mock_client = allocate(/datum/client_interface)
	var/obj/item/spacepod_equipment/cargo/crate/cargo = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The crate cargo module could not be installed.")
	var/obj/structure/closet/crate/crate = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/flashlight/payload = allocate(__IMPLIED_TYPE__, crate)
	var/previous_usr = usr
	usr = user
	crate.MouseDrop(pod)
	usr = previous_usr
	TEST_ASSERT_EQUAL(cargo.storage, crate, "Dragging a closed crate onto the pod did not load it.")
	TEST_ASSERT_EQUAL(crate.loc, cargo, "Dragging the crate did not move the actual crate inside.")
	TEST_ASSERT(pod.mob_try_enter(user), "The loader could not board as pilot.")
	TEST_ASSERT(pod.unload(user), "The pilot could not unload the original crate.")
	TEST_ASSERT(isturf(crate.loc) && !(crate.loc in pod.locs), "The unloaded crate is hidden underneath the pod's footprint.")
	TEST_ASSERT(pod.Adjacent(crate), "The unloaded crate was placed out of reach of the pod.")
	TEST_ASSERT_EQUAL(payload.loc, crate, "Unloading separated the crate from its payload.")
	TEST_ASSERT_NULL(cargo.storage, "The cargo module retained ownership after a successful unload.")
	pod.mob_exit(user, silent = TRUE)
	user.forceMove(crate.loc)
	usr = user
	crate.MouseDrop(pod)
	usr = previous_usr
	TEST_ASSERT_EQUAL(cargo.storage, crate, "The external loader could not reload the crate.")
	pod.unlocked = FALSE
	TEST_ASSERT(!pod.unload(user), "An external user unloaded a locked pod.")
	TEST_ASSERT_EQUAL(crate.loc, cargo, "A rejected locked unload moved the crate.")
	pod.unlocked = TRUE
	TEST_ASSERT(pod.unload(user), "A nearby external user could not unload the unlocked pod.")
	TEST_ASSERT(isturf(crate.loc) && !(crate.loc in pod.locs), "External unloading hid the crate underneath the pod.")

/// Removing a loaded fitting may drop its crate underneath the hull, but closing it must leave the pod outside.
/datum/unit_test/spacepod_cargo_removed_module_containment/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/spacepod_equipment/cargo/crate/cargo = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The removal fixture could not install its cargo module.")
	var/obj/structure/closet/crate/crate = allocate(__IMPLIED_TYPE__, user.loc)
	var/obj/item/flashlight/payload = allocate(__IMPLIED_TYPE__, crate)
	TEST_ASSERT(pod.load_cargo(user, crate), "The removal fixture could not load the original crate.")
	var/obj/item/crowbar/crowbar = allocate(__IMPLIED_TYPE__, user.loc)
	TEST_ASSERT(user.put_in_active_hand(crowbar), "The technician could not hold the crowbar.")
	TEST_ASSERT(pod.crowbar_act(user, crowbar) && pod.hatch_open, "The technician could not open the service hatch.")
	user.dropItemToGround(crowbar)
	user.add_or_update_variable_actionspeed_modifier(/datum/actionspeed_modifier/base, multiplicative_slowdown = 1)
	TEST_ASSERT(pod.remove_equipment(user, cargo, cargo.slot), "Removing the loaded fitting through the normal timed service path failed.")
	TEST_ASSERT_EQUAL(crate.loc, origin, "The removed module did not release its original crate onto the pod's turf.")
	TEST_ASSERT_NULL(pod.cargo_system, "The removed module still occupies the cargo slot.")
	TEST_ASSERT_NULL(cargo.storage, "The removed module still owns the released crate.")
	TEST_ASSERT(crate.open(user), "The released crate could not be opened.")
	TEST_ASSERT(crate.close(user), "The released crate could not be closed on the pod's turf.")
	TEST_ASSERT_EQUAL(pod.loc, origin, "The released crate swallowed the entire pod after module removal.")
	TEST_ASSERT_EQUAL(length(pod.locs), 4, "Closing the released crate changed the pod's footprint.")
	TEST_ASSERT_EQUAL(payload.loc, crate, "Opening and closing the released crate lost its original payload.")

/// No free output must preserve the original cargo; the internal loot action uses the same safe output.
/datum/unit_test/spacepod_cargo_output_and_selection/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/pilot = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/spacepod_equipment/cargo/crate/cargo = allocate(__IMPLIED_TYPE__, origin)
	var/obj/item/spacepod_equipment/sec_cargo/loot_box/auxiliary = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The crate cargo module could not be installed.")
	TEST_ASSERT(pod.add_equipment(null, auxiliary, auxiliary.slot), "The small cargo module could not be installed.")
	var/obj/structure/closet/crate/crate = allocate(__IMPLIED_TYPE__, cargo)
	cargo.storage = crate
	var/obj/item/flashlight/loot = allocate(__IMPLIED_TYPE__, auxiliary)
	TEST_ASSERT(pod.mob_enter(pilot, silent = TRUE), "The test pilot could not board.")
	var/list/output_turfs = list()
	for(var/turf/footprint as anything in pod.locs)
		for(var/direction in GLOB.cardinals)
			var/turf/candidate = get_step(footprint, direction)
			if(candidate && !(candidate in pod.locs))
				output_turfs |= candidate
	var/list/blockers = list()
	for(var/turf/output_turf as anything in output_turfs)
		blockers += allocate(/obj/structure/closet/crate, output_turf)
	TEST_ASSERT_NULL(pod.find_cargo_unload_turf(), "An entirely blocked hull perimeter still has a cargo output.")
	TEST_ASSERT(!pod.unload(pilot), "Unloading forced a crate through a blocked perimeter.")
	TEST_ASSERT_EQUAL(crate.loc, cargo, "Failed unloading lost the crate.")
	TEST_ASSERT_EQUAL(cargo.storage, crate, "Failed unloading cleared ownership of the crate.")
	TEST_ASSERT(!auxiliary.unload_item(pilot, loot), "Internal loot selection forced an item through a blocked perimeter.")
	TEST_ASSERT_EQUAL(loot.loc, auxiliary, "A failed internal selection moved the original item.")
	QDEL_LIST(blockers)
	TEST_ASSERT(auxiliary.unload_item(pilot, loot), "The pilot could not unload a selected item onto a free outside tile.")
	TEST_ASSERT(isturf(loot.loc) && !(loot.loc in pod.locs), "The selected item is hidden underneath the hull.")
	TEST_ASSERT(HAS_TRAIT_FROM(pilot, TRAIT_HANDS_BLOCKED, VEHICLE_TRAIT), "The cargo operation unblocked the pilot's hands.")
	TEST_ASSERT(!auxiliary.unload_item(pilot, loot), "A stale selection unloaded an item that has already left the cargo bay.")
	var/obj/item/flashlight/next_loot = allocate(/obj/item/flashlight, auxiliary)
	pod.mob_exit(pilot, silent = TRUE)
	TEST_ASSERT(!auxiliary.unload_item(pilot, next_loot), "The internal cargo selection remained usable after the pilot exited.")
	TEST_ASSERT_EQUAL(next_loot.loc, auxiliary, "Rejected pilot-exit revalidation moved the remaining cargo.")

/// Closing a real crate must not fold an empty or occupied 2x2 vehicle into its contents.
/datum/unit_test/spacepod_cargo_closet_containment/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/sec/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/technician = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/spacepod_equipment/cargo/crate/cargo = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The containment fixture could not install a cargo module.")
	var/obj/structure/closet/crate/payload_crate = allocate(__IMPLIED_TYPE__, technician.loc)
	var/obj/item/flashlight/payload = allocate(__IMPLIED_TYPE__, payload_crate)
	TEST_ASSERT(pod.load_cargo(technician, payload_crate), "The containment fixture could not load its real crate.")
	var/obj/structure/closet/crate/container = allocate(__IMPLIED_TYPE__, origin)
	var/obj/item/flashlight/loose_item = allocate(__IMPLIED_TYPE__, origin)
	var/list/footprint = pod.locs.Copy()
	var/list/crew = list()
	for(var/state in list("empty", "occupied"))
		TEST_ASSERT(container.open(technician), "The fixture crate could not be opened for the [state] pod.")
		if(state == "occupied")
			for(var/index in 1 to 2)
				var/mob/living/carbon/human/consistent/occupant = allocate(__IMPLIED_TYPE__, technician.loc)
				TEST_ASSERT(pod.mob_enter(occupant, silent = TRUE), "The containment fixture could not board occupant [index].")
				crew += occupant
		TEST_ASSERT(container.close(technician), "The crate could not close beside the [state] pod.")
		TEST_ASSERT_EQUAL(loose_item.loc, container, "The real crate did not collect the loose 1x1 control item.")
		TEST_ASSERT_EQUAL(pod.loc, origin, "Closing a crate swallowed the [state] pod.")
		TEST_ASSERT_EQUAL(length(pod.locs), 4, "Crate closing changed the [state] pod's 2x2 footprint.")
		for(var/turf/expected as anything in footprint)
			TEST_ASSERT((expected in pod.locs), "Crate closing moved the [state] pod off its original footprint.")
		TEST_ASSERT_EQUAL(length(pod.occupants), length(crew), "Crate closing changed the [state] pod's registered crew.")
		for(var/mob/living/occupant as anything in crew)
			TEST_ASSERT(pod.is_occupant(occupant) && occupant.loc == pod, "Crate closing detached an occupant from the cabin.")
		TEST_ASSERT_EQUAL(pod.cargo_system, cargo, "Crate closing detached the installed cargo module.")
		TEST_ASSERT_EQUAL(cargo.loc, pod, "Crate closing moved the cargo module out of its owner.")
		TEST_ASSERT_EQUAL(cargo.storage, payload_crate, "Crate closing cleared the loaded cargo's ownership.")
		TEST_ASSERT_EQUAL(payload_crate.loc, cargo, "Crate closing extracted the loaded crate from its module.")
		TEST_ASSERT_EQUAL(payload.loc, payload_crate, "Crate closing lost the loaded crate's contents.")
		TEST_ASSERT_EQUAL(pod.battery.loc, pod, "Crate closing extracted the cabin's battery.")
		TEST_ASSERT_EQUAL(pod.internal_tank.loc, pod, "Crate closing extracted the cabin's reserve tank.")

/// Administrative nesting stays possible, but cargo loading may not create containment cycles.
/datum/unit_test/spacepod_cargo_nested_loading/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/turf/service_turf = get_step(origin, SOUTH)
	for(var/nested in list("pod", "crate"))
		var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
		var/mob/living/carbon/human/consistent/technician = allocate(__IMPLIED_TYPE__, service_turf)
		var/obj/item/spacepod_equipment/cargo/crate/cargo = allocate(__IMPLIED_TYPE__, origin)
		TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The nested fixture could not install its cargo module.")
		var/obj/structure/closet/crate/crate = allocate(__IMPLIED_TYPE__, service_turf)
		var/obj/structure/closet/crate/outer = allocate(__IMPLIED_TYPE__, service_turf)
		if(nested == "pod")
			TEST_ASSERT(pod.forceMove(crate), "The administrative ancestor-crate fixture could not be constructed.")
		else
			TEST_ASSERT(crate.forceMove(outer), "The administrative nested-target fixture could not be constructed.")
		TEST_ASSERT(!pod.load_cargo(technician, crate), "Cargo loading accepted a contained [nested].")
		TEST_ASSERT_NULL(cargo.storage, "Rejected [nested] nesting left stale cargo ownership.")
		TEST_ASSERT_EQUAL(pod.loc, nested == "pod" ? crate : origin, "Rejected [nested] nesting moved the pod.")
		TEST_ASSERT_EQUAL(crate.loc, nested == "crate" ? outer : service_turf, "Rejected [nested] nesting moved the target crate.")
		TEST_ASSERT_EQUAL(cargo.my_atom, pod, "Rejected [nested] nesting detached the cargo module's owner.")
		TEST_ASSERT_EQUAL(cargo.loc, pod, "Rejected [nested] nesting moved the installed cargo module.")
		TEST_ASSERT(pod.forceMove(origin), "Administrative restoration could not return the pod to the station.")
		TEST_ASSERT(crate.forceMove(service_turf), "Administrative restoration could not return the target crate to the floor.")
		TEST_ASSERT(pod.load_cargo(technician, crate), "Restoring ordinary floor placement did not restore cargo loading.")
		TEST_ASSERT_EQUAL(cargo.storage, crate, "Successful loading did not record the original crate.")
		TEST_ASSERT_EQUAL(crate.loc, cargo, "Successful loading did not transfer the original crate.")
		qdel(pod)
		qdel(crate)
		qdel(outer)
		qdel(technician)

/// Moving either participant into a container after the real do_after starts must cancel loading.
/datum/unit_test/spacepod_cargo_containment_races/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/turf/service_turf = get_step(origin, SOUTH)
	for(var/nested in list("pod", "crate"))
		var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
		var/mob/living/carbon/human/consistent/technician = allocate(__IMPLIED_TYPE__, service_turf)
		technician.add_or_update_variable_actionspeed_modifier(/datum/actionspeed_modifier/base, multiplicative_slowdown = 1)
		TEST_ASSERT_EQUAL(technician.cached_multiplicative_actions_slowdown, 1, "The loader must use the real four-second action delay.")
		var/obj/item/spacepod_equipment/cargo/crate/cargo = allocate(__IMPLIED_TYPE__, origin)
		TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The race fixture could not install its cargo module.")
		var/obj/structure/closet/crate/crate = allocate(__IMPLIED_TYPE__, service_turf)
		var/obj/structure/closet/crate/outer = allocate(__IMPLIED_TYPE__, service_turf)
		var/list/outcome = list("finished" = FALSE, "success" = FALSE)
		ASYNC
			outcome["success"] = pod.load_cargo(technician, crate)
			outcome["finished"] = TRUE
		TEST_ASSERT(DOING_INTERACTION(technician, pod), "Cargo loading did not start its real timed interaction for [nested] nesting.")
		if(nested == "pod")
			TEST_ASSERT(pod.forceMove(outer), "The pending pod could not be administratively moved into a container.")
		else
			TEST_ASSERT(crate.forceMove(outer), "The pending crate could not be administratively nested.")
		var/deadline = world.time + 6 SECONDS
		while(!outcome["finished"] && world.time < deadline)
			stoplag(1)
		TEST_ASSERT(outcome["finished"], "The pending cargo load never finished after [nested] nesting.")
		TEST_ASSERT(!DOING_INTERACTION(technician, pod), "The rejected cargo load retained its timed interaction.")
		TEST_ASSERT(!outcome["success"], "Cargo loading ignored [nested] nesting during its delay.")
		TEST_ASSERT_NULL(cargo.storage, "Mid-action [nested] nesting left stale cargo ownership.")
		TEST_ASSERT_EQUAL(pod.loc, nested == "pod" ? outer : origin, "The rejected pending load moved the pod.")
		TEST_ASSERT_EQUAL(crate.loc, nested == "crate" ? outer : service_turf, "The rejected pending load moved the target crate.")
		qdel(pod)
		qdel(crate)
		qdel(outer)
		qdel(technician)
