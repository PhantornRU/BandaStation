/// A real inventory click must retrieve loot without exposing the pod's machinery.
/datum/unit_test/spacepod_cargo_external_loot/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/spacepod_equipment/sec_cargo/loot_box/cargo = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The small cargo bay could not be installed.")
	var/obj/item/flashlight/loot = allocate(__IMPLIED_TYPE__, user.loc)
	TEST_ASSERT(user.put_in_active_hand(loot), "The technician could not hold the test flashlight.")
	loot.melee_attack_chain(user, pod, list())
	TEST_ASSERT_EQUAL(loot.loc, cargo, "The normal item attack chain did not load the installed cargo bay.")
	TEST_ASSERT(loot.IsReachableBy(user), "A nearby technician cannot reach the contents of an unlocked cargo bay.")
	TEST_ASSERT(!pod.battery.IsReachableBy(user), "Opening the cargo bay also exposed the installed battery.")
	TEST_ASSERT(!pod.internal_tank.IsReachableBy(user), "Opening the cargo bay also exposed the reserve tank.")
	click_wrapper(user, cargo)
	TEST_ASSERT_EQUAL(cargo.loc, pod, "A cargo access click removed the installed module through the closed hatch.")
	TEST_ASSERT_EQUAL(pod.sec_cargo_system, cargo, "A cargo access click detached the installed module.")
	click_wrapper(user, loot)
	TEST_ASSERT(user.is_holding(loot), "A real inventory click did not put the original cargo item into the technician's hand.")
	TEST_ASSERT_EQUAL(loot.loc, user, "The retrieved item is still inside the cargo bay.")
	TEST_ASSERT(!(loot.item_flags & IN_STORAGE), "The retrieved item retained its storage flag.")

/// Cargo permissions must also govern clicks made through an already-open inventory.
/datum/unit_test/spacepod_cargo_loot_permissions/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/turf/service_turf = get_step(origin, SOUTH)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, service_turf)
	var/obj/item/spacepod_equipment/sec_cargo/loot_box/cargo = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The test cargo bay could not be installed.")
	var/obj/item/flashlight/loot = allocate(__IMPLIED_TYPE__, user.loc)
	TEST_ASSERT(user.put_in_active_hand(loot), "The technician could not hold the test cargo.")
	loot.melee_attack_chain(user, pod, list())
	TEST_ASSERT_EQUAL(loot.loc, cargo, "The test cargo was not inserted through the normal item attack chain.")
	for(var/condition in list("locked", "open_hatch", "far", "combat", "blocked_hands"))
		switch(condition)
			if("locked")
				pod.unlocked = FALSE
			if("open_hatch")
				pod.hatch_open = TRUE
			if("far")
				user.forceMove(locate(origin.x + 4, origin.y + 4, origin.z))
			if("combat")
				user.set_combat_mode(TRUE)
			if("blocked_hands")
				ADD_TRAIT(user, TRAIT_HANDS_BLOCKED, TRAIT_SOURCE_UNIT_TESTS)
		TEST_ASSERT(!loot.IsReachableBy(user), "[condition] still allowed native reach into the cargo bay.")
		click_wrapper(user, loot)
		TEST_ASSERT_EQUAL(loot.loc, cargo, "[condition] allowed a stale cargo-inventory click to take the item.")
		pod.unlocked = TRUE
		pod.hatch_open = FALSE
		user.forceMove(service_turf)
		user.set_combat_mode(FALSE)
		REMOVE_TRAIT(user, TRAIT_HANDS_BLOCKED, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT(loot.IsReachableBy(user), "Restoring access did not make the cargo item reachable again.")
	TEST_ASSERT(pod.remove_equipment(null, cargo, cargo.slot), "The test cargo module could not be removed.")
	TEST_ASSERT(!pod.IsContainedAtomAccessible(cargo, user), "A detached cargo module is still treated as installed storage.")

/// A dragged crate must be recoverable from both the pilot controls and outside the pod.
/datum/unit_test/spacepod_cargo_crate_roundtrip/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	pod.enter_delay = 0
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/spacepod_equipment/cargo/crate/cargo = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The crate cargo module could not be installed.")
	var/obj/structure/closet/crate/crate = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/flashlight/payload = allocate(__IMPLIED_TYPE__, crate)
	pod.mouse_drop_receive(crate, user, null)
	TEST_ASSERT_EQUAL(cargo.storage, crate, "Dragging a closed crate onto the pod did not load it.")
	TEST_ASSERT_EQUAL(crate.loc, cargo, "Dragging the crate did not move the actual crate inside.")
	TEST_ASSERT(pod.mob_try_enter(user), "The loader could not board as pilot.")
	TEST_ASSERT(pod.unload(user), "The pilot could not unload the original crate.")
	TEST_ASSERT(isturf(crate.loc) && !(crate.loc in pod.locs), "The unloaded crate is hidden underneath the pod's footprint.")
	TEST_ASSERT(pod.Adjacent(crate), "The unloaded crate was placed out of reach of the pod.")
	TEST_ASSERT_EQUAL(payload.loc, crate, "Unloading separated the crate from its payload.")
	TEST_ASSERT_NULL(cargo.storage, "The cargo module retained ownership after a successful unload.")
	pod.mob_exit(user, silent = TRUE)
	user.forceMove(crate.loc)
	pod.mouse_drop_receive(crate, user, null)
	TEST_ASSERT_EQUAL(cargo.storage, crate, "The external loader could not reload the crate.")
	pod.unlocked = FALSE
	TEST_ASSERT(!pod.unload(user), "An external user unloaded a locked pod.")
	TEST_ASSERT_EQUAL(crate.loc, cargo, "A rejected locked unload moved the crate.")
	pod.unlocked = TRUE
	TEST_ASSERT(pod.unload(user), "A nearby external user could not unload the unlocked pod.")
	TEST_ASSERT(isturf(crate.loc) && !(crate.loc in pod.locs), "External unloading hid the crate underneath the pod.")

/// No free output must preserve the original cargo; the internal loot action uses the same safe output.
/datum/unit_test/spacepod_cargo_output_and_selection/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 3, run_loc_floor_bottom_left.y + 3, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/pilot = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/item/spacepod_equipment/cargo/crate/cargo = allocate(__IMPLIED_TYPE__, origin)
	var/obj/item/spacepod_equipment/sec_cargo/loot_box/auxiliary = allocate(__IMPLIED_TYPE__, origin)
	TEST_ASSERT(pod.add_equipment(null, cargo, cargo.slot), "The crate cargo module could not be installed.")
	TEST_ASSERT(pod.add_equipment(null, auxiliary, auxiliary.slot), "The small cargo module could not be installed.")
	var/obj/structure/closet/crate/crate = allocate(__IMPLIED_TYPE__, cargo)
	cargo.storage = crate
	var/obj/item/flashlight/loot = allocate(__IMPLIED_TYPE__, auxiliary)
	TEST_ASSERT(pod.mob_enter(pilot, silent = TRUE), "The test pilot could not board.")
	var/list/output_turfs = list()
	for(var/turf/footprint as anything in pod.locs)
		for(var/direction in GLOB.cardinals)
			var/turf/candidate = get_step(footprint, direction)
			if(candidate && !(candidate in pod.locs))
				output_turfs |= candidate
	var/list/blockers = list()
	for(var/turf/output_turf as anything in output_turfs)
		blockers += allocate(/obj/structure/closet/crate, output_turf)
	TEST_ASSERT_NULL(pod.find_cargo_unload_turf(), "An entirely blocked hull perimeter still has a cargo output.")
	TEST_ASSERT(!pod.unload(pilot), "Unloading forced a crate through a blocked perimeter.")
	TEST_ASSERT_EQUAL(crate.loc, cargo, "Failed unloading lost the crate.")
	TEST_ASSERT_EQUAL(cargo.storage, crate, "Failed unloading cleared ownership of the crate.")
	TEST_ASSERT(!auxiliary.unload_item(pilot, loot), "Internal loot selection forced an item through a blocked perimeter.")
	TEST_ASSERT_EQUAL(loot.loc, auxiliary, "A failed internal selection moved the original item.")
	QDEL_LIST(blockers)
	TEST_ASSERT(auxiliary.unload_item(pilot, loot), "The pilot could not unload a selected item onto a free outside tile.")
	TEST_ASSERT(isturf(loot.loc) && !(loot.loc in pod.locs), "The selected item is hidden underneath the hull.")
	TEST_ASSERT(HAS_TRAIT_FROM(pilot, TRAIT_HANDS_BLOCKED, VEHICLE_TRAIT), "The cargo operation unblocked the pilot's hands.")
	TEST_ASSERT(!auxiliary.unload_item(pilot, loot), "A stale selection unloaded an item that has already left the cargo bay.")
	var/obj/item/flashlight/next_loot = allocate(/obj/item/flashlight, auxiliary)
	pod.mob_exit(pilot, silent = TRUE)
	TEST_ASSERT(!auxiliary.unload_item(pilot, next_loot), "The internal cargo selection remained usable after the pilot exited.")
	TEST_ASSERT_EQUAL(next_loot.loc, auxiliary, "Rejected pilot-exit revalidation moved the remaining cargo.")
