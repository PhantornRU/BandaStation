/// Exchange the actual machinery canister through the public drag handler without losing either gas mixture.
/datum/unit_test/spacepod_tank_exchange/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 2, run_loc_floor_bottom_left.y + 2, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/civilian/pod = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	user.mock_client = new()
	var/obj/item/crowbar/crowbar = allocate(__IMPLIED_TYPE__, get_turf(user))
	TEST_ASSERT(user.put_in_hands(crowbar), "The tank technician could not hold a crowbar.")
	TEST_ASSERT(pod.crowbar_act(user, crowbar) && pod.hatch_open, "The native crowbar interaction did not open the service hatch.")
	var/obj/machinery/portable_atmospherics/canister/original = pod.internal_tank
	var/datum/gas_mixture/original_air = original.return_air()
	var/original_moles = original_air.total_moles()
	var/datum/gas_mixture/cabin = pod.cabin_air
	var/cabin_moles = cabin.total_moles()
	var/cabin_oxygen = cabin.moles[/datum/gas/oxygen]
	TEST_ASSERT(pod.remove_internal_tank(user), "An outside technician could not remove the original canister onto their own turf.")
	TEST_ASSERT_NULL(pod.internal_tank, "Removing the original canister did not clear the reserve reference.")
	TEST_ASSERT_EQUAL(original.loc, get_turf(user), "The canister was not placed at the technician's feet.")
	TEST_ASSERT_EQUAL(original.return_air(), original_air, "Removal replaced the original canister's gas datum.")
	TEST_ASSERT_EQUAL(original_air.total_moles(), original_moles, "Removal discarded or generated reserve gas.")
	original.forceMove(locate(origin.x - 1, origin.y + 1, origin.z))
	var/obj/machinery/portable_atmospherics/canister/air/replacement = allocate(__IMPLIED_TYPE__, get_step(get_turf(user), EAST))
	var/datum/gas_mixture/replacement_air = replacement.return_air()
	var/replacement_moles = replacement_air.total_moles()
	var/datum/tgui/canister_ui = allocate(/datum/tgui, user, replacement, "Canister")
	canister_ui.window = allocate(/datum/tgui_window/spacepod_unit_test)
	canister_ui.window.acquire_lock(canister_ui)
	SStgui.on_open(canister_ui)
	user.start_pulling(replacement)
	TEST_ASSERT_EQUAL(user.pulling, replacement, "The native pulling fixture did not start pulling the replacement.")
	var/previous_usr = usr
	usr = user // Native MouseDrop uses the acting client's usr.
	replacement.MouseDrop(pod)
	usr = previous_usr
	TEST_ASSERT_EQUAL(replacement.loc, pod, "The real canister drag handler did not install the replacement.")
	TEST_ASSERT_EQUAL(pod.internal_tank, replacement, "Drag installation did not assign the actual replacement canister.")
	TEST_ASSERT_EQUAL(replacement.loc, pod, "The installed canister is not inside the hull.")
	TEST_ASSERT_NULL(user.pulling, "Installing the canister retained a remote native pulling link.")
	TEST_ASSERT(QDELETED(canister_ui), "Installing a canister retained its old valve-control UI.")
	TEST_ASSERT(!(canister_ui in SStgui.all_uis) && !(canister_ui in user.tgui_open_uis) && !length(replacement.open_uis), "Installing the canister left its old UI registered.")
	TEST_ASSERT_EQUAL(replacement.return_air(), replacement_air, "Installation replaced the canister's actual gas datum.")
	TEST_ASSERT_EQUAL(replacement_air.total_moles(), replacement_moles, "Installation discarded or generated reserve gas.")
	TEST_ASSERT_EQUAL(pod.cabin_air, cabin, "Changing the reserve replaced the cabin atmosphere.")
	TEST_ASSERT_EQUAL(cabin.total_moles(), cabin_moles, "Changing the reserve implicitly flushed or filled the cabin.")
	TEST_ASSERT_EQUAL(cabin.moles[/datum/gas/oxygen], cabin_oxygen, "Changing the reserve silently changed cabin oxygen.")
	TEST_ASSERT(pod.remove_internal_tank(user), "The installed replacement could not be removed through the actual service helper.")
	TEST_ASSERT_EQUAL(replacement.loc, get_turf(user), "Removing the replacement did not return the original machinery object.")
	TEST_ASSERT_EQUAL(replacement_air.total_moles(), replacement_moles, "A complete install/remove cycle lost reserve gas.")

/// Reject all service permission failures, and respect the extraction turf's actual dense contents.
/datum/unit_test/spacepod_tank_authorization/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 2, run_loc_floor_bottom_left.y + 2, run_loc_floor_bottom_left.z)
	for(var/prohibited in list("hatch", "lock", "meltdown", "combat", "stun", "hands", "distance", "inside", "nested_pod"))
		var/obj/vehicle/sealed/spacepod/civilian/pod = allocate(__IMPLIED_TYPE__, origin)
		pod.hatch_open = TRUE
		var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
		var/obj/machinery/portable_atmospherics/canister/original = pod.internal_tank
		var/obj/machinery/portable_atmospherics/canister/air/replacement = allocate(__IMPLIED_TYPE__, get_step(get_turf(user), EAST))
		var/obj/structure/closet/crate/container
		switch(prohibited)
			if("hatch")
				pod.hatch_open = FALSE
			if("lock")
				pod.unlocked = FALSE
			if("meltdown")
				pod.melting_down = TRUE
			if("combat")
				user.set_combat_mode(TRUE)
			if("stun")
				user.Stun(10 SECONDS)
			if("hands")
				ADD_TRAIT(user, TRAIT_HANDS_BLOCKED, TRAIT_SOURCE_UNIT_TESTS)
			if("distance")
				user.forceMove(run_loc_floor_bottom_left)
			if("inside")
				pod.hatch_open = FALSE
				TEST_ASSERT(pod.mob_enter(user, silent = TRUE), "The inside-technician fixture could not board.")
				pod.hatch_open = TRUE
			if("nested_pod")
				container = allocate(/obj/structure/closet/crate, origin)
				pod.forceMove(container)
		TEST_ASSERT(!pod.can_service_internal_tank(user), "Service authorization ignored [prohibited].")
		TEST_ASSERT(!pod.remove_internal_tank(user), "Canister removal ignored [prohibited].")
		TEST_ASSERT_EQUAL(pod.internal_tank, original, "Rejected removal changed the installed reserve for [prohibited].")
		original.forceMove(locate(origin.x - 1, origin.y + 1, origin.z))
		TEST_ASSERT_NULL(pod.internal_tank, "Forced relocation did not prepare the empty-slot authorization fixture.")
		TEST_ASSERT(!pod.install_internal_tank(user, replacement), "Canister installation ignored [prohibited] with an empty slot.")
		TEST_ASSERT(replacement.loc != pod, "Rejected installation moved the canister for [prohibited].")
		qdel(pod)
		qdel(user)
		qdel(original)
		qdel(replacement)
		if(container)
			qdel(container)
	var/obj/vehicle/sealed/spacepod/civilian/clearance_pod = allocate(__IMPLIED_TYPE__, origin)
	clearance_pod.hatch_open = TRUE
	var/mob/living/carbon/human/consistent/technician = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/machinery/portable_atmospherics/canister/reserve = clearance_pod.internal_tank
	var/obj/structure/closet/crate/blocker = allocate(__IMPLIED_TYPE__, get_turf(technician))
	TEST_ASSERT(!clearance_pod.remove_internal_tank(technician), "Extraction placed a dense canister on another dense object.")
	TEST_ASSERT_EQUAL(clearance_pod.internal_tank, reserve, "A blocked extraction lost the installed reserve.")
	qdel(blocker)
	technician.forceMove(origin)
	TEST_ASSERT(clearance_pod.can_service_internal_tank(technician), "The footprint-clearance fixture failed a different service permission check.")
	TEST_ASSERT(!clearance_pod.remove_internal_tank(technician), "Extraction placed the canister inside the pod's 2x2 footprint.")
	technician.forceMove(get_step(origin, SOUTH))
	TEST_ASSERT(clearance_pod.remove_internal_tank(technician), "The technician alone was incorrectly treated as an extraction obstruction.")
	TEST_ASSERT_EQUAL(reserve.loc, get_turf(technician), "Successful extraction did not use the now-clear technician turf.")

/// A real pipenet connection, an open valve and damaged or inaccessible machinery must not enter the hull.
/datum/unit_test/spacepod_tank_canister_states/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 2, run_loc_floor_bottom_left.y + 2, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/civilian/pod = allocate(__IMPLIED_TYPE__, origin)
	pod.hatch_open = TRUE
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/machinery/portable_atmospherics/canister/air/tank = allocate(__IMPLIED_TYPE__, get_step(get_turf(user), EAST))
	TEST_ASSERT(!pod.install_internal_tank(user, tank), "Installing a canister overwrote an occupied reserve slot.")
	var/obj/machinery/portable_atmospherics/canister/original = pod.internal_tank
	original.forceMove(locate(origin.x - 1, origin.y + 1, origin.z))
	var/turf/tank_turf = get_turf(tank)
	tank.set_anchored(TRUE)
	TEST_ASSERT(!pod.install_internal_tank(user, tank), "Anchored machinery entered the hull.")
	tank.set_anchored(FALSE)
	tank.valve_open = TRUE
	TEST_ASSERT(!pod.install_internal_tank(user, tank), "A canister with an open release valve entered the hull.")
	tank.valve_open = FALSE
	tank.machine_stat |= BROKEN
	TEST_ASSERT(!pod.install_internal_tank(user, tank), "Broken machinery entered the reserve slot.")
	tank.machine_stat &= ~BROKEN
	var/obj/structure/closet/crate/container = allocate(__IMPLIED_TYPE__, tank_turf)
	tank.forceMove(container)
	TEST_ASSERT(!pod.install_internal_tank(user, tank), "A canister nested inside another container entered the hull.")
	tank.forceMove(run_loc_floor_bottom_left)
	TEST_ASSERT(!pod.install_internal_tank(user, tank), "A distant canister entered the hull.")
	tank.forceMove(tank_turf)
	qdel(container)
	var/obj/machinery/atmospherics/components/unary/portables_connector/port = allocate(__IMPLIED_TYPE__, tank_turf)
	port.atmos_init()
	var/datum/pipeline/pipenet = port.get_rebuild_target()
	pipenet.build_pipeline_blocking(port)
	TEST_ASSERT(tank.connect(port), "The actual portable connector did not connect the canister.")
	TEST_ASSERT_EQUAL(port.connected_device, tank, "The native connector did not register its canister.")
	TEST_ASSERT(!pod.install_internal_tank(user, tank), "A live pipenet-connected canister entered the hull.")
	TEST_ASSERT_EQUAL(tank.connected_port, port, "Rejected installation silently disconnected the native pipe connection.")
	TEST_ASSERT_EQUAL(tank.loc, tank_turf, "Rejected installation moved the connected canister.")
	TEST_ASSERT(tank.disconnect(), "The native connector could not release the tested canister.")
	qdel(port)
	QDEL_NULL(tank.air_contents)
	var/installed_without_gas = pod.install_internal_tank(user, tank)
	qdel(tank)
	TEST_ASSERT(!installed_without_gas, "A canister without its gas datum entered the reserve slot.")
	TEST_ASSERT_NULL(pod.internal_tank, "Rejected canister states populated the empty reserve slot.")

/// Moving or deleting canisters updates ownership; only the currently installed one belongs to the pod.
/datum/unit_test/spacepod_tank_ownership/Run()
	var/turf/origin = locate(run_loc_floor_bottom_left.x + 2, run_loc_floor_bottom_left.y + 2, run_loc_floor_bottom_left.z)
	var/obj/vehicle/sealed/spacepod/civilian/pod = allocate(__IMPLIED_TYPE__, origin)
	pod.hatch_open = TRUE
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(origin, SOUTH))
	var/obj/machinery/portable_atmospherics/canister/original = pod.internal_tank
	original.forceMove(locate(origin.x - 1, origin.y + 1, origin.z))
	TEST_ASSERT_NULL(pod.internal_tank, "Forced relocation left the initial canister installed remotely.")
	var/obj/machinery/portable_atmospherics/canister/air/removed_tank = allocate(__IMPLIED_TYPE__, get_step(get_turf(user), EAST))
	TEST_ASSERT(pod.install_internal_tank(user, removed_tank), "The ownership fixture could not install its replacement.")
	qdel(original)
	TEST_ASSERT_EQUAL(pod.internal_tank, removed_tank, "Deleting a formerly owned canister cleared the new installed reserve.")
	removed_tank.forceMove(get_step(get_turf(user), EAST))
	TEST_ASSERT_NULL(pod.internal_tank, "Forced removal retained the replacement's reserve reference.")
	var/obj/machinery/portable_atmospherics/canister/air/deleted_tank = allocate(__IMPLIED_TYPE__, get_step(get_turf(user), WEST))
	TEST_ASSERT(pod.install_internal_tank(user, deleted_tank), "The ownership fixture could not install its deletion candidate.")
	qdel(deleted_tank)
	TEST_ASSERT_NULL(pod.internal_tank, "Deleting the installed canister retained its reserve reference.")
	var/obj/machinery/portable_atmospherics/canister/air/final_tank = allocate(__IMPLIED_TYPE__, get_step(get_turf(user), WEST))
	TEST_ASSERT(pod.install_internal_tank(user, final_tank), "The ownership fixture could not install its final reserve.")
	qdel(pod)
	TEST_ASSERT(QDELETED(final_tank), "Deleting the pod did not delete its owned installed canister.")
	TEST_ASSERT(!QDELETED(removed_tank) && isturf(removed_tank.loc), "Deleting the pod deleted a previously removed external canister.")

/// Swapping the source preserves contaminated cabin gas; an actually low-pressure cabin draws finite new reserve gas.
/datum/unit_test/spacepod_vacuum/tank_supply/Run()
	TEST_ASSERT_NOTNULL(vacuum_origin, "Could not reserve actual vacuum for canister supply checks.")
	var/obj/vehicle/sealed/spacepod/civilian/pod = allocate(__IMPLIED_TYPE__, vacuum_origin)
	pod.hatch_open = TRUE
	var/mob/living/carbon/human/consistent/user = allocate(__IMPLIED_TYPE__, get_step(vacuum_origin, SOUTH))
	user.mock_client = new()
	var/obj/machinery/portable_atmospherics/canister/original = pod.internal_tank
	TEST_ASSERT(pod.remove_internal_tank(user), "The supply fixture could not remove its old reserve.")
	original.forceMove(locate(vacuum_origin.x - 1, vacuum_origin.y + 1, vacuum_origin.z))
	var/datum/gas_mixture/cabin = pod.cabin_air
	qdel(cabin.remove_ratio(1))
	cabin.set_gas(/datum/gas/carbon_dioxide, ONE_ATMOSPHERE * cabin.volume / (R_IDEAL_GAS_EQUATION * cabin.temperature))
	var/cabin_carbon_dioxide = cabin.moles[/datum/gas/carbon_dioxide]
	var/obj/machinery/portable_atmospherics/canister/air/replacement = allocate(__IMPLIED_TYPE__, get_step(get_turf(user), EAST))
	var/datum/gas_mixture/reserve_air = replacement.return_air()
	var/reserve_before = reserve_air.total_moles()
	var/previous_usr = usr
	usr = user // Native MouseDrop uses the acting client's usr.
	replacement.MouseDrop(pod)
	usr = previous_usr
	TEST_ASSERT_EQUAL(replacement.loc, pod, "The fresh reserve could not be installed through the actual drag handler.")
	pod.give_air()
	TEST_ASSERT_EQUAL(pod.cabin_air, cabin, "Changing the source replaced the cabin atmosphere datum.")
	TEST_ASSERT_EQUAL(cabin.moles[/datum/gas/carbon_dioxide], cabin_carbon_dioxide, "Installing a reserve implicitly scrubbed or purged cabin CO2.")
	TEST_ASSERT_EQUAL(cabin.moles[/datum/gas/oxygen] || 0, 0, "A fresh reserve silently generated oxygen in an already full-pressure cabin.")
	TEST_ASSERT_EQUAL(reserve_air.total_moles(), reserve_before, "The regulator consumed reserve gas despite an already full-pressure cabin.")
	qdel(cabin.remove_ratio(1))
	var/gas_before = reserve_air.total_moles() + cabin.total_moles()
	pod.give_air()
	TEST_ASSERT(reserve_air.total_moles() < reserve_before, "The low-pressure cabin did not draw gas from the new actual canister.")
	TEST_ASSERT(cabin.moles[/datum/gas/oxygen] > 0, "The fresh air reserve did not supply oxygen to the empty cabin.")
	TEST_ASSERT(abs(cabin.return_pressure() - ONE_ATMOSPHERE) < 0.1, "The fresh canister did not refill the low-pressure cabin to the native regulator target.")
	TEST_ASSERT(abs(reserve_air.total_moles() + cabin.total_moles() - gas_before) < 0.001, "Refilling the cabin lost or generated gas between the new canister and cabin.")
