/datum/unit_test/syndicate_items_contraband/Run()
	var/obj/item/inspector/scanner = allocate(/obj/item/inspector)
	scanner.scans_correctly = TRUE
	var/list/stock = list(
		/datum/uplink_item/stealthy_weapons/garrote = 4,
		/datum/uplink_item/implants/binyat = 5,
		/datum/uplink_item/implants/razorwire = 8,
		/datum/uplink_item/implants/kaleido = 2,
		/datum/uplink_item/implants/mantis = 12,
	)
	for(var/entry_type in stock)
		var/datum/uplink_item/entry = allocate(entry_type)
		var/obj/item/product = allocate(entry.item)
		TEST_ASSERT_EQUAL(entry.cost, stock[entry_type], "Incorrect uplink price for [entry_type].")
		TEST_ASSERT(scanner.contraband_scan(product), "Scanner missed purchased [product.type].")
		if(istype(product, /obj/item/autosurgeon))
			var/obj/item/autosurgeon/surgeon = product
			TEST_ASSERT(scanner.contraband_scan(surgeon.stored_organ), "Scanner missed extracted [surgeon.stored_organ.type].")
	var/list/implants = list(
		/obj/item/organ/cyberimp/brain/binyat,
		/obj/item/organ/cyberimp/arm/toolkit/razorwire,
		/obj/item/organ/eyes/robotic/kaleido,
		/obj/item/organ/cyberimp/arm/toolkit/mantis,
		/obj/item/organ/cyberimp/arm/toolkit/mantis/left,
	)
	for(var/implant_type in implants)
		var/mob/living/carbon/human/host = allocate(/mob/living/carbon/human/consistent)
		TEST_ASSERT(!scanner.contraband_scan(host), "Unmodified host already carries contraband.")
		var/obj/item/organ/implant = allocate(implant_type)
		TEST_ASSERT(implant.Insert(host), "Could not install [implant_type].")
		TEST_ASSERT(scanner.contraband_scan(host), "Scanner missed installed [implant_type].")

/datum/unit_test/syndicate_garrote/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/garrote/garrote = allocate(/obj/item/garrote)
	user.put_in_active_hand(garrote)
	victim.forceMove(get_step(user, EAST))
	victim.setDir(EAST)
	garrote.attack(victim, user)
	TEST_ASSERT_NULL(garrote.strangling, "One-handed garrote started strangling.")
	var/datum/component/two_handed/two_handed = garrote.GetComponent(/datum/component/two_handed)
	two_handed.wield(user)
	TEST_ASSERT(HAS_TRAIT(garrote, TRAIT_WIELDED), "Garrote could not be wielded in both hands.")
	victim.setDir(WEST)
	garrote.attack(victim, user)
	TEST_ASSERT_NULL(garrote.strangling, "Garrote worked from in front of a conscious victim.")
	victim.setDir(EAST)
	garrote.attack(victim, user)
	TEST_ASSERT_EQUAL(garrote.strangling, victim, "Garrote failed from behind.")
	TEST_ASSERT(HAS_TRAIT(victim, TRAIT_MUTE), "Garrote did not silence its victim.")
	TEST_ASSERT(HAS_TRAIT(victim, TRAIT_EMOTEMUTE), "Garrote still allows audible emotes.")
	TEST_ASSERT_EQUAL(user.grab_state, GRAB_NECK, "Garrote did not establish a neck grab.")
	TEST_ASSERT(!victim.resist_grab(), "Victim escaped an active garrote.")
	garrote.attack(victim, user)
	TEST_ASSERT_EQUAL(user.grab_state, GRAB_KILL, "Garrote did not instantly tighten.")
	garrote.process(2)
	var/oxy_loss = victim.get_oxy_loss()
	TEST_ASSERT(oxy_loss > 0, "Tightened garrote dealt no oxygen damage.")
	victim.adjust_oxy_loss(-100)
	TEST_ASSERT_EQUAL(victim.get_oxy_loss(), oxy_loss, "Victim healed oxygen damage while strangled.")
	user.stop_pulling()
	TEST_ASSERT_NULL(garrote.strangling, "Garrote retained a released victim.")
	TEST_ASSERT(!HAS_TRAIT(victim, TRAIT_MUTE) && !HAS_TRAIT(victim, TRAIT_EMOTEMUTE), "Released victim remains silenced.")
	victim.adjust_oxy_loss(-100)
	TEST_ASSERT_EQUAL(victim.get_oxy_loss(), 0, "Released victim cannot heal oxygen damage.")
	victim.setDir(EAST)
	garrote.attack(victim, user)
	two_handed.unwield(user)
	TEST_ASSERT_NULL(garrote.strangling, "Unwielding retained a garrote victim.")
	TEST_ASSERT(!HAS_TRAIT(victim, TRAIT_MUTE), "Unwielding left the victim silenced.")

/datum/unit_test/syndicate_razorwire/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/cyberimp/arm/toolkit/razorwire/implant = allocate(/obj/item/organ/cyberimp/arm/toolkit/razorwire)
	implant.Insert(user)
	implant.ui_action_click()
	var/obj/item/melee/razorwire/wire = implant.active_item
	TEST_ASSERT(user.is_holding(wire), "Razorwire did not extend into its implanted hand.")
	if(user.get_active_held_item() != wire)
		user.swap_hand(user.get_held_index_of_item(wire))
	TEST_ASSERT_EQUAL(user.get_active_held_item(), wire, "Razorwire is not in the active hand.")
	var/obj/item/screwdriver/tool = allocate(/obj/item/screwdriver)
	victim.put_in_active_hand(tool)
	victim.forceMove(get_step(get_step(user, EAST), EAST))
	user.set_combat_mode(TRUE)
	TEST_ASSERT(victim.IsReachableBy(user, wire.reach), "Razorwire cannot reach the two-tile target.")
	click_wrapper(user, victim)
	TEST_ASSERT(victim.get_brute_loss() > 0, "Razorwire click did not attack: active=[user.get_active_held_item()], incap=[user.incapacitated], hands=[HAS_TRAIT(user, TRAIT_HANDS_BLOCKED)], no_transform=[HAS_TRAIT(user, TRAIT_NO_TRANSFORM)].")
	TEST_ASSERT(!victim.is_holding(tool), "Razorwire failed to disarm on a hit.")
	TEST_ASSERT(victim.get_brute_loss() > 0, "Razorwire did not damage the victim.")
	TEST_ASSERT(wire.weak_against_armour, "Razorwire lost its armor weakness.")
	var/obj/item/shield/riot/shield = allocate(/obj/item/shield/riot)
	shield.block_chance = 1000
	victim.put_in_active_hand(shield)
	wire.attack(victim, user)
	TEST_ASSERT(victim.is_holding(shield), "Blocked razorwire attack disarmed the defender.")
	implant.Retract()
	TEST_ASSERT(!user.is_holding(wire), "Razorwire did not retract.")

/datum/unit_test/syndicate_binyat/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human)
	var/obj/item/organ/cyberimp/brain/binyat/implant = allocate(/obj/item/organ/cyberimp/brain/binyat)
	implant.Insert(user)
	var/datum/action/cooldown/binyat/hacking = locate() in implant.actions
	TEST_ASSERT_EQUAL(hacking.owner, user, "Installed Binyat did not grant its action.")
	var/obj/machinery/chem_dispenser/station = allocate(/obj/machinery/chem_dispenser)
	station.forceMove(get_step(get_step(get_step(user, EAST), EAST), EAST))
	TEST_ASSERT(hacking.Activate(station), "Binyat failed to emag local machinery through its action.")
	TEST_ASSERT(station.obj_flags & EMAGGED, "Binyat did not unlock the machine's TG emag behavior.")
	var/obj/machinery/door/firedoor/door = allocate(/obj/machinery/door/firedoor)
	door.forceMove(get_step(user, EAST))
	TEST_ASSERT(hacking.hack(door, user), "Binyat lost door hacking.")
	TEST_ASSERT(door.obj_flags & EMAGGED, "Binyat did not emag the firedoor.")
	var/obj/machinery/camera/camera = allocate(/obj/machinery/camera)
	camera.forceMove(get_step(user, EAST))
	TEST_ASSERT(camera.can_use(), "Test camera started disabled.")
	var/list/network = camera.network.Copy()
	TEST_ASSERT(hacking.hack(camera, user), "Binyat failed to disable a camera.")
	TEST_ASSERT(!camera.can_use(), "Hacked camera remained usable.")
	sleep(31 SECONDS)
	TEST_ASSERT(camera.can_use(), "Camera failed to recover after temporary hacking.")
	TEST_ASSERT_EQUAL(camera.network.len, network.len, "Camera did not recover its original networks.")
	TEST_ASSERT_EQUAL(camera.network[1], network[1], "Recovered camera joined the wrong network.")
	camera.emp_act(EMP_HEAVY, reset_time = 0.2 SECONDS)
	camera.emp_act(EMP_HEAVY, reset_time = 0.4 SECONDS)
	sleep(1 SECONDS)
	TEST_ASSERT(camera.can_use(), "Repeated camera EMP did not recover.")
	TEST_ASSERT_EQUAL(camera.network[1], network[1], "Repeated camera EMP lost its network.")
	station.forceMove(get_step(get_step(get_step(get_step(user, EAST), EAST), EAST), EAST))
	TEST_ASSERT(!hacking.can_hack(station), "Binyat allowed a target outside its three-tile range.")
	var/obj/machinery/chem_dispenser/second_station = allocate(/obj/machinery/chem_dispenser)
	second_station.forceMove(get_step(user, EAST))
	var/burn_before = user.get_fire_loss()
	var/hack_started = world.time
	addtimer(CALLBACK(implant, TYPE_PROC_REF(/obj/item/organ, Remove), user, TRUE), 0.2 SECONDS)
	var/result = hacking.Activate(second_station)
	TEST_ASSERT(!result, "Binyat completed a hack after removal: elapsed=[world.time - hack_started], slowdown=[user.cached_multiplicative_actions_slowdown], implant_owner=[implant.owner], action_owner=[hacking.owner].")
	TEST_ASSERT(!(second_station.obj_flags & EMAGGED), "Removed Binyat still modified its target.")
	TEST_ASSERT_EQUAL(user.get_fire_loss(), burn_before, "Interrupted Binyat still burned its former owner.")
	TEST_ASSERT_NULL(hacking.owner, "Removed Binyat retained its action owner.")

/datum/unit_test/syndicate_kaleido/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/organ/eyes/robotic/kaleido/eyes = allocate(/obj/item/organ/eyes/robotic/kaleido)
	TEST_ASSERT(eyes.Insert(user), "Kaleido eyes could not be installed.")
	TEST_ASSERT_EQUAL(eyes.scope.range_modifier, 4, "Kaleido does not use binocular zoom.")
	TEST_ASSERT(eyes.emp_act(EMP_HEAVY) & EMP_PROTECT_SELF, "Hardened Kaleido eyes are not EMP protected.")
	var/datum/action/item_action/organ_action/toggle/action = locate() in eyes.actions
	TEST_ASSERT_EQUAL(action.owner, user, "Kaleido eyes did not grant a toggle action.")
	eyes.Remove(user, special = TRUE)
	TEST_ASSERT_NULL(action.owner, "Removed Kaleido eyes retained their action owner.")

/datum/unit_test/syndicate_mantis/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent)
	victim.forceMove(get_step(user, EAST))
	var/obj/item/organ/cyberimp/arm/toolkit/mantis/right = allocate(/obj/item/organ/cyberimp/arm/toolkit/mantis)
	var/obj/item/organ/cyberimp/arm/toolkit/mantis/left/left = allocate(/obj/item/organ/cyberimp/arm/toolkit/mantis/left)
	right.Insert(user)
	left.Insert(user)
	right.ui_action_click()
	left.ui_action_click()
	var/obj/item/melee/mantis_blade/first = user.get_active_held_item()
	var/obj/item/melee/mantis_blade/second = user.get_inactive_held_item()
	TEST_ASSERT(istype(first) && istype(second), "Both mantis blades did not extend.")
	TEST_ASSERT_EQUAL(first.armour_penetration, 0, "Mantis blade unexpectedly penetrates armor.")
	var/list/attack_modifiers = list()
	first.attack(victim, user, attack_modifiers = attack_modifiers)
	var/first_damage = victim.get_brute_loss()
	sleep(0.3 SECONDS)
	TEST_ASSERT(victim.get_brute_loss() > first_damage, "Second mantis blade did not land its delayed attack.")
	TEST_ASSERT(!second.hit_reaction(user, victim, "test", 1000, 0, MELEE_ATTACK, BRUTE), "Offhand mantis blade independently rolled another block.")
	TEST_ASSERT(first.hit_reaction(user, victim, "test", 1000, 0, MELEE_ATTACK, BRUTE), "Active mantis blade cannot block.")
	var/obj/item/bodypart/arm = user.get_bodypart(right.zone)
	var/initial_burn = arm.burn_dam
	right.emp_act(EMP_HEAVY)
	TEST_ASSERT(arm.burn_dam > initial_burn, "Mantis EMP did not burn the implanted arm.")

/datum/unit_test/syndicate_mantis_kit/Run()
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/storage/box/syndie_kit/mantis/kit = allocate(/obj/item/storage/box/syndie_kit/mantis)
	var/obj/item/autosurgeon/syndicate/mantis/right = locate(/obj/item/autosurgeon/syndicate/mantis) in kit.contents
	var/obj/item/autosurgeon/syndicate/mantis/left/left = locate(/obj/item/autosurgeon/syndicate/mantis/left) in kit.contents
	var/obj/item/organ/right_implant = right.stored_organ
	var/obj/item/organ/left_implant = left.stored_organ
	user.put_in_active_hand(right)
	right.use_autosurgeon(user, user)
	user.dropItemToGround(right)
	user.put_in_active_hand(left)
	left.use_autosurgeon(user, user)
	TEST_ASSERT_EQUAL(user.get_organ_slot(ORGAN_SLOT_RIGHT_ARM_AUG), right_implant, "Kit did not install the right-arm blade.")
	TEST_ASSERT_EQUAL(user.get_organ_slot(ORGAN_SLOT_LEFT_ARM_AUG), left_implant, "Kit's second autosurgeon replaced the first arm implant.")
