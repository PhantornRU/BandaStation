/datum/unit_test/job_extension_hooks/Run()
	var/datum/client_interface/player = allocate(/datum/client_interface)
	player.prefs = allocate(/datum/preferences, player)
	var/datum/job/cargo = SSjob.get_job_type(/datum/job/cargo_technician)
	var/datum/preference/variant_preference = GLOB.preference_entries[/datum/preference/job_outfit_variants]
	TEST_ASSERT(player.prefs.write_preference(variant_preference, list(JOB_CARGO_TECHNICIAN = "deliverer")), "Could not select free Deliverer")
	var/mob/living/carbon/human/body = allocate(/mob/living/carbon/human/consistent)
	cargo.prepare_spawn_character(body, player.prefs)
	var/datum/job_variant_context/context = body.job_variant_context
	TEST_ASSERT_NOTNULL(context, "The neutral preparation hook lost the live variant")
	TEST_ASSERT_EQUAL(cargo.get_spawn_outfit(body, player.prefs, FALSE, TRUE), /datum/outfit/job/cargo_tech/deliverer, "Live outfit lost its selected variant")
	var/mob/living/carbon/human/preview = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT_EQUAL(cargo.get_spawn_outfit(preview, player.prefs, TRUE, TRUE), /datum/outfit/job/cargo_tech/deliverer, "Preview lost the selected variant")
	TEST_ASSERT_NULL(preview.job_variant_context, "The outfit getter attached live state to a preview")
	TEST_ASSERT(player.prefs.write_preference(variant_preference, list(JOB_CARGO_TECHNICIAN = "default")), "Could not change the editor variant")
	TEST_ASSERT_EQUAL(cargo.get_spawn_outfit(body, player.prefs, FALSE, TRUE), /datum/outfit/job/cargo_tech/deliverer, "An editor change replaced the committed live outfit")
	TEST_ASSERT_EQUAL(cargo.get_spawn_outfit(preview, player.prefs, TRUE, TRUE), cargo.get_outfit(TRUE), "Default preview no longer uses native equipment")
	qdel(body)
	TEST_ASSERT(QDELETED(context), "The context outlived its deleted body")

	var/datum/job/ordinary = SSjob.get_job_type(/datum/job/assistant)
	ordinary.prepare_spawn_character(preview, player.prefs)
	TEST_ASSERT_NULL(preview.job_variant_context, "An ordinary job acquired donor state")
	TEST_ASSERT_NULL(ordinary.get_join_lock_reason(player), "The neutral hook locked an ordinary job")
	TEST_ASSERT_EQUAL(ordinary.get_spawn_outfit(preview, player.prefs, FALSE, TRUE), ordinary.get_outfit(TRUE), "The default hook bypassed native get_outfit")
	TEST_ASSERT_NULL(cargo.get_join_lock_reason(player), "The free Cargo/Deliverer job requires a subscription")

/datum/unit_test/job_extension_hooks/Destroy()
	release_job_player_fixtures()
	return ..()
